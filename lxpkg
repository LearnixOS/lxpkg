#!/usr/bin/env python3
import os
import argparse
import ctypes
import sqlite3
import subprocess
import urllib.request
import shutil
import toml
from rich.console import Console
from rich.panel import Panel
from rich.progress import Progress
from rich.table import Table
from rich.tree import Tree
from config import SOURCES_BASE_DIR, BUILD_DIR, INSTALL_DIR, LOG_DIR
from logger import logger

console = Console()
DB_PATH = os.path.join(INSTALL_DIR, "package_db.sqlite")

# Load the C library
liblxpkg = ctypes.CDLL("./liblxpkg.so")

# Define C function signatures
liblxpkg.extract_tarball.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
liblxpkg.extract_tarball.restype = ctypes.c_int
liblxpkg.install_files.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_char_p), ctypes.c_int]
liblxpkg.install_files.restype = ctypes.c_int
liblxpkg.check_system_install.argtypes = [ctypes.c_char_p]
liblxpkg.check_system_install.restype = ctypes.c_int

# Initialize SQLite database
def init_db():
    os.makedirs(INSTALL_DIR, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS packages
                 (name TEXT PRIMARY KEY, version TEXT, files TEXT)''')
    conn.commit()
    conn.close()

def load_package_info(toml_path):
    with open(toml_path, 'r') as file:
        return toml.load(file)

def fetch_source(url, dest_dir):
    filename = os.path.join(dest_dir, os.path.basename(url))
    if os.path.exists(filename) and os.path.getsize(filename) > 0:
        logger.info(f"{filename} already exists. Skipping download.")
        console.print(f"[bold green]{filename} already exists. Skipping download.[/bold green]")
    else:
        logger.info(f"Downloading {url}...")
        console.print(f"[bold cyan]Downloading {url}...[/bold cyan]")
        with Progress() as progress:
            task = progress.add_task(f"[cyan]{os.path.basename(url)}[/cyan]", total=100)
            def update_progress(block_num, block_size, total_size):
                if total_size > 0:
                    progress.update(task, total=total_size, advance=block_num * block_size)
            urllib.request.urlretrieve(url, filename, reporthook=update_progress)
    return filename

def extract_tarball(tarball, dest_dir):
    logger.info(f"Extracting {tarball}...")
    console.print(f"[bold cyan]Extracting {tarball}...[/bold cyan]")
    result = liblxpkg.extract_tarball(tarball.encode(), dest_dir.encode())
    if result != 0:
        logger.error(f"Failed to extract {tarball}")
        os.remove(tarball)
        return extract_tarball(fetch_source(tarball, dest_dir), dest_dir)  # Redownload and retry
    extracted_dirs = [os.path.join(dest_dir, d) for d in os.listdir(dest_dir) if os.path.isdir(os.path.join(dest_dir, d))]
    return extracted_dirs[0] if extracted_dirs else dest_dir


def build_package(src_dir, build_config, dry_run=False):
    logger.info(f"Building package in {src_dir}...")
    console.print(f"[bold cyan]Building package in {src_dir}...[/bold cyan]")
    
    # Auto-run autoreconf if configure is missing but configure.ac exists
    configure_missing = not os.path.exists(os.path.join(src_dir, 'configure'))
    configure_ac_exists = os.path.exists(os.path.join(src_dir, 'configure.ac')) or os.path.exists(os.path.join(src_dir, 'configure.in'))
    if configure_missing and configure_ac_exists and any('configure' in cmd for stage, cmds in build_config.items() for cmd in (cmds if isinstance(cmds, list) else [cmds])):
        logger.info("No configure script found, running autoreconf...")
        console.print("[bold yellow]No configure script found, running autoreconf...[/bold yellow]")
        if not dry_run:
            result = subprocess.run("autoreconf -fiv", shell=True, cwd=src_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if result.returncode != 0:
                logger.error(f"Error: {result.stderr.decode()}")
                console.print(f"[bold red]Error: {result.stderr.decode()}[/bold red]")
                raise Exception("autoreconf failed")
        else:
            console.print("[bold green][Dry Run] Would run autoreconf -fiv[/bold green]")

    for stage, commands in build_config.items():
        logger.info(f"Executing {stage} stage...")
        console.print(f"[bold cyan]{stage.capitalize()} stage...[/bold cyan]")
        if not isinstance(commands, list):
            commands = [commands]
        for command in commands:
            logger.info(f"Running: {command}")
            console.print(f"[bold yellow]Running: {command}[/bold yellow]")
            if not dry_run:
                result = subprocess.run(command, shell=True, cwd=src_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                if result.returncode != 0:
                    logger.error(f"Error: {result.stderr.decode()}")
                    console.print(f"[bold red]Error: {result.stderr.decode()}[/bold red]")
                    raise Exception(f"Command '{command}' in stage '{stage}' failed.")
            else:
                console.print("[bold green][Dry Run] Skipped execution[/bold green]")

def install_files(src_dir, install_dir, files, dry_run=False):
    if dry_run:
        console.print("[bold green][Dry Run] Would install files[/bold green]")
        return
    logger.info(f"Installing files from {src_dir} to {install_dir}...")
    console.print(f"[bold cyan]Installing files...[/bold cyan]")
    c_files = (ctypes.c_char_p * len(files))()
    for i, f in enumerate(files):
        c_files[i] = f.encode()
    result = liblxpkg.install_files(src_dir.encode(), install_dir.encode(), c_files, len(files))
    if result != 0:
        logger.error("File installation failed")
        raise Exception("File installation failed")

def find_package_toml(package_name):
    for root, _, files in os.walk(SOURCES_BASE_DIR):
        for file in files:
            if file.endswith('.toml') and package_name in file:
                return os.path.join(root, file)
    return None

def is_package_installed_system(package_name):
    result = liblxpkg.check_system_install(package_name.encode())
    if result:
        logger.info(f"Detected {package_name} on system")
    return bool(result)

def get_installed_version(package_name):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT version FROM packages WHERE name = ?", (package_name,))
    result = c.fetchone()
    conn.close()
    return result[0] if result else None

def save_package_info(package_name, version, files):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO packages (name, version, files) VALUES (?, ?, ?)",
              (package_name, version, ','.join(files)))
    conn.commit()
    conn.close()

def check_conflicts(package_name, files):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT name, files FROM packages")
    for installed_name, installed_files in c.fetchall():
        if installed_name != package_name:
            installed_files_list = installed_files.split(',')
            conflicting_files = set(files) & set(installed_files_list)
            if conflicting_files:
                conn.close()
                return f"Conflict with {installed_name}: {', '.join(conflicting_files)}"
    conn.close()
    return None

def install_package(package_name, dry_run=False, dependency_tree=None, processed_deps=None):
    if processed_deps is None:
        processed_deps = set()

    installed_version = get_installed_version(package_name)
    system_installed = is_package_installed_system(package_name)
    toml_path = find_package_toml(package_name)

    if (installed_version or system_installed) and not dry_run:
        console.print(f"[bold green][x] Package '{package_name}' already installed.[/bold green]")
        return True

    if not toml_path:
        console.print(f"[bold yellow][ ] Package '{package_name}' not found in sources.[/bold yellow]")
        return False

    package_info = load_package_info(toml_path)
    package = package_info['package']
    build = package_info.get('build', {})
    version = package.get('version', 'unknown')

    if 'dependencies' in package_info:
        if dependency_tree is None:
            dependency_tree = Tree(f"[bold cyan]Dependency Tree for {package_name}[/bold cyan]")
        dep_branch = dependency_tree.add(f"[yellow]{package_name}[/yellow]")
        for dep_name, dep_version in package_info['dependencies'].items():
            if dep_name in processed_deps:
                dep_branch.add(f"[green][x] {dep_name} ({dep_version}) - already processed[/green]")
                continue
            processed_deps.add(dep_name)
            dep_node = dep_branch.add(f"[magenta][ ] {dep_name} ({dep_version})[/magenta]")
            console.print(f"[bold cyan]Checking dependency: {dep_name} ({dep_version})[/bold cyan]")
            installed = install_package(dep_name, dry_run, dependency_tree, processed_deps)
            dep_node.label = f"[green][x] {dep_name} ({dep_version})[/green]" if installed else f"[red][ ] {dep_name} ({dep_version}) - not installed[/red]"

    if not dry_run:
        console.print(dependency_tree)

    if not (installed_version or system_installed):
        tarball = fetch_source(package['src'][0], os.path.dirname(toml_path))
        src_dir = extract_tarball(tarball, BUILD_DIR)

        install_files_list = package_info.get('install', {}).get('files', [])
        full_install_files = [os.path.join(INSTALL_DIR, f.lstrip('/')) for f in install_files_list]
        conflict = check_conflicts(package_name, full_install_files)
        if conflict and not dry_run:
            raise Exception(f"Installation aborted: {conflict}")

        if build:
            build_package(src_dir, build, dry_run)

        install_files(src_dir, INSTALL_DIR, install_files_list, dry_run)

        if not dry_run:
            shutil.rmtree(src_dir)
            os.remove(tarball)
            save_package_info(package_name, version, full_install_files)
            logger.info(f"Package '{package_name}' installed successfully.")
            console.print(Panel(f"[bold green][x] Package '{package_name}' installed![/bold green]", style="green"))
        else:
            console.print(Panel(f"[bold green][Dry Run] Package '{package_name}' would be installed[/bold green]", style="green"))
    return True

def search_packages(query):
    logger.info(f"Searching for '{query}'...")
    console.print(f"[bold cyan]Searching for '{query}'...[/bold cyan]")
    matches = []
    for root, _, files in os.walk(SOURCES_BASE_DIR):
        for file in files:
            if file.endswith('.toml') and query in file:
                package_name = file.replace('.toml', '')
                toml_path = find_package_toml(package_name)
                if toml_path:
                    installed = get_installed_version(package_name) is not None or is_package_installed_system(package_name)
                    matches.append((package_name, installed, toml_path))
    
    if matches:
        table = Table(title="Matching Packages")
        table.add_column("Status", style="green")
        table.add_column("Package Name", style="cyan")
        table.add_column("Location", style="magenta")
        for package_name, installed, toml_path in matches:
            status = "[x]" if installed else "[ ]"
            table.add_row(status, package_name, toml_path)
        console.print(table)
    else:
        console.print("[bold yellow]No matching packages found.[/bold yellow]")

def list_installed_packages():
    logger.info("Listing installed packages...")
    console.print("[bold cyan]Listing installed packages...[/bold cyan]")
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT name, version FROM packages")
    installed = c.fetchall()
    conn.close()
    if installed:
        table = Table(title="Installed Packages")
        table.add_column("Status", style="green")
        table.add_column("Package Name", style="cyan")
        table.add_column("Version", style="magenta")
        for name, version in installed:
            table.add_row("[x]", name, version)
        console.print(table)
    else:
        console.print("[bold yellow]No installed packages found in LXPKG database.[/bold yellow]")

def remove_package(package_name, dry_run=False):
    logger.info(f"Removing '{package_name}'...")
    console.print(f"[bold cyan]Removing '{package_name}'...[/bold cyan]")
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT files FROM packages WHERE name = ?", (package_name,))
    result = c.fetchone()
    if not result and not is_package_installed_system(package_name):
        conn.close()
        raise Exception(f"Package '{package_name}' not found.")
    files_to_remove = result[0].split(',') if result else []

    for file in files_to_remove:
        if os.path.exists(file) and not dry_run:
            os.remove(file)
            console.print(f"[bold yellow]Removed {file}[/bold yellow]")
        elif dry_run:
            console.print(f"[bold green][Dry Run] Would remove {file}[/bold green]")

    if not dry_run and result:
        c.execute("DELETE FROM packages WHERE name = ?", (package_name,))
        conn.commit()
        console.print(Panel(f"[bold green]✔ Package '{package_name}' removed![/bold green]", style="green"))
    else:
        console.print(Panel(f"[bold green][Dry Run] Package '{package_name}' would be removed[/bold green]", style="green"))
    conn.close()

def update_package(package_name, dry_run=False):
    logger.info(f"Updating '{package_name}'...")
    console.print(f"[bold cyan]Updating '{package_name}'...[/bold cyan]")
    remove_package(package_name, dry_run)
    install_package(package_name, dry_run)
    if not dry_run:
        console.print(Panel(f"[bold green]✔ Package '{package_name}' updated![/bold green]", style="green"))

def update_all(dry_run=False):
    logger.info("Updating all installed packages...")
    console.print("[bold cyan]Updating all installed packages...[/bold cyan]")
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT name FROM packages")
    packages = [row[0] for row in c.fetchall()]
    conn.close()
    for package in packages:
        update_package(package, dry_run)
    if not dry_run:
        console.print(Panel("[bold green]✔ All packages updated![/bold green]", style="green"))

def clean_build_dir():
    logger.info("Cleaning build directory...")
    console.print("[bold cyan]Cleaning build directory...[/bold cyan]")
    if os.path.exists(BUILD_DIR):
        shutil.rmtree(BUILD_DIR)
        os.makedirs(BUILD_DIR, exist_ok=True)
        console.print("[bold green]✔ Build directory cleaned![/bold green]")
    else:
        console.print("[bold yellow]Build directory does not exist.[/bold yellow]")


def main():
    parser = argparse.ArgumentParser(description='LXPKG - Hybrid Package Manager')
    parser.add_argument('command', choices=['install', 'search', 'remove', 'update', 'update-all', 'list', 'clean'], 
                        help='Command to run')
    parser.add_argument('package', nargs='?', help='Name of the package (not required for update-all, list, clean)')
    parser.add_argument('--dry-run', action='store_true', help='Simulate actions without executing them')

    args = parser.parse_args()

    init_db()

    try:
        if args.command == 'install':
            if not args.package:
                raise Exception("Package name required for install.")
            install_package(args.package, args.dry_run)  # Corrected from args.d_run
        elif args.command == 'search':
            if not args.package:
                raise Exception("Query required for search.")
            search_packages(args.package)
        elif args.command == 'remove':
            if not args.package:
                raise Exception("Package name required for remove.")
            remove_package(args.package, args.dry_run)
        elif args.command == 'update':
            if not args.package:
                raise Exception("Package name required for update.")
            update_package(args.package, args.dry_run)
        elif args.command == 'update-all':
            update_all(args.dry_run)
        elif args.command == 'list':
            list_installed_packages()
        elif args.command == 'clean':
            clean_build_dir()
    except Exception as e:
        logger.error(f"Error: {e}")
        console.print(Panel(f"[bold red]Error: {e}[/bold red]", style="red"))

if __name__ == "__main__":
    main()
