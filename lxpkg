#!/bin/sh
# lxpkg: Simple package manager for lxos (https://learnixos.github.io)


set -f

log() {
    printf '%b%s %b%s%b\n' "$c1" "==>" "$c2" "$*" "$c3"
}

warn() {
    printf '%b%s %b%s%b\n' "$c1" "WARNING:" "$c2" "$*" "$c3" >&2
}

die() {
    # Check if the message is the usage text (starts with "Usage: lxpkg")
    if [ "${1#Usage: lxpkg}" != "$1" ]; then
        # Print usage message line by line without color/italic formatting
        printf 'ERROR: %s\n' "$1" >&2
        shift
        for line; do
            printf '%s\n' "$line" >&2
        done
    else
        # Print other error messages with grey/italic formatting
        printf '%b%s %b%s%b\n' "$c1" "ERROR:" "$c2" "$*" "$c3" >&2
    fi
    exit 1
}

ok() {
    [ -e "$1" ] || return 1
}

equ() {
    [ "$1" = "$2" ]
}

contains() {
    case " $1 " in *" $2 "*) return 0; esac
    return 1
}

prompt() {
    printf '%b%s%b\n' "$c2" "$*" "$c3"
    printf '%b%s%b' "$c1" "Continue? [Enter/Ctrl+C] " "$c3"
    read -r _
}

pkg_find() {
    _pkg_find "$@" || die "'$1' not found"
}

_pkg_find() {
    set -- "$1" "$2" "$3" "${4:-"$LXPKG_PATH"}"
    IFS=:
    for _find_path in $4 "${3:-$sys_db}"; do set +f
        ok "$_find_path" || continue
        for _find_pkg in $(find "$_find_path" -maxdepth 2 -type d -name "$1" 2>/dev/null); do
            test "${3:--d}" "$_find_pkg" && set -f -- "$@" "$_find_pkg"
        done
    done
    unset IFS
    case $2-$# in
        *-4) return 1 ;;
         -*) repo_dir=$5; repo_name=${5##*/} ;;
          *) shift 4; printf '%s\n' "$@"
    esac
}

pkg_find_version() {
    set -- "$1" "${2:-1}" "$3" "$4"
    pkg_find "$1" "$2" "$3" "$4"
    read -r ver_pre rel_pre < "$repo_dir/version" 2>/dev/null || {
        ver_pre=; rel_pre=
    }
    case $2 in
        1) [ -z "$ver_pre" ] || set -- "$1" "" "$3" "$4"
    esac
    pkg_find "$1" "" "$3" "$4"
    read -r repo_ver repo_rel < "$repo_dir/version" 2>/dev/null || {
        repo_ver=; repo_rel=
    }
}

pkg_cache() {
    ok "$repo_dir" || pkg_find "$1"
    ok "$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS" || {
        set +f
        for cache in "$cache_dir/$1"*.tar.*; do
            ok "$cache" && {
                mv -f "$cache" "$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS"
                break
            }
        done
        set -f
    }
    ok "$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS" || return 1
    printf '%s\n' "$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS"
}

pkg_checksums() {
    pkg_find "$1"
    if [ -f "$repo_dir/checksums" ]; then
        cat "$repo_dir/checksums"
    else
        warn "No checksums found for $1"
        return 1
    fi
}

pkg_sources() {
    pkg_find "$1"
    if [ -f "$repo_dir/sources" ]; then
        cat "$repo_dir/sources"
    else
        warn "No sources found for $1"
        return 1
    fi
}

pkg_depends() {
    pkg_find "$1"
    if [ -f "$repo_dir/depends" ]; then
        cat "$repo_dir/depends" | while read -r dep make; do
            [ "$make" = "make" ] || printf '%s\n' "$dep"
        done
    fi
}

pkg_is_installed() {
    [ -d "$sys_db/$1" ]
}

pkg_resolve_deps() {
    unset _seen_deps
    log "Resolving dependencies for $@..."
    _resolve_deps "$@" || die "Failed to resolve dependencies for $@"
}

_resolve_deps() {
    for pkg in "$@"; do
        contains "$_seen_deps" "$pkg" && continue
        _seen_deps="$_seen_deps $pkg"
        pkg_find "$pkg" || die "Dependency $pkg not found in repository"
        if [ -f "$repo_dir/depends" ]; then
            log "$pkg depends on: $(cat "$repo_dir/depends" | tr '\n' ' ')"
            for dep in $(pkg_depends "$pkg"); do
                if ! pkg_is_installed "$dep"; then
                    log "Installing missing dependency: $dep"
                    _resolve_deps "$dep"
                    pkg_build "$dep"
                    pkg_install "$dep"
                else
                    log "Dependency $dep is already installed"
                fi
            done
        else
            log "$pkg has no explicit dependencies listed"
        fi
    done
}

pkg_order() {
    unset _seen
    _pkg_order "$@"
    printf '%s\n' $order
}

_pkg_order() {
    for pkg; do
        contains "$_seen" "$pkg" && continue
        _seen="$_seen $pkg"
        for dep in $(pkg_depends "$pkg"); do
            _pkg_order "$dep"
        done
        order="$order $pkg"
    done
}

pkg_verify() {
    pkg_find "$1"
    cd "$repo_dir"
    if [ "${LXPKG_SKIP_CHECKSUMS:-0}" != "1" ] && ! pkg_checksums "$1" >/dev/null; then
        die "Checksum verification is required for $1. Provide a checksums file or set LXPKG_SKIP_CHECKSUMS=1 to skip."
    fi
    set +f
    i=1
    pkg_checksums "$1" | while read -r sum; do
        for src in $(pkg_sources "$1" | sed -n "$i p"); do
            case $src in
                *::*)
                    src=${src#*::}
                    src=${src##* }
                    ;;
                *)
                    src=${src##* }
                    ;;
            esac
            ok "$src" || continue
            if [ -f "$cmd_b3" ]; then
                b3sum "$src" 2>/dev/null | {
                    read -r b3 _
                    equ "$b3" "$sum" || die "Checksum mismatch for $src (blake3)"
                }
            elif [ -f "$cmd_sha" ]; then
                case $cmd_sha in
                    *openssl) dgst=sha256 ;;
                    *digest) dgst=-sha256 ;;
                    *) dgst= ;;
                esac
                "$cmd_sha" $dgst "$src" 2>/dev/null | {
                    read -r sha _
                    equ "$sha" "$sum" || die "Checksum mismatch for $src (sha256)"
                }
            else
                die "No checksum utility found"
            fi
            i=$((i + 1))
        done
    done
    cd "$ppwd"
}

pkg_source() {
    pkg_find "$1"
    mkdir -p "$src_dir/$1"
    cd "$src_dir/$1"
    set +f
    i=1
    pkg_sources "$1" | while read -r src dest; do
        case $src in
            *::*)
                src=${src#*::}
                src=${src##* }
                ;;
            *)
                src=${src##* }
                ;;
        esac
        case $dest in
            */*) mkdir -p "${dest%/*}" ;;
        esac
        dest=${dest:-${src##*/}}
        ok "$dest" && continue
        log "Downloading $1: $src to $dest..."
        # Run the download in the background
        {
            case $cmd_get in
                *aria2c) aria2c -o "$dest" "$src" >/dev/null 2>&1 ;;
                *axel) axel -o "$dest" "$src" >/dev/null 2>&1 ;;
                *curl) curl -fLo "$dest" "$src" >/dev/null 2>&1 ;;
                *wget*) wget -O "$dest" "$src" >/dev/null 2>&1 ;;
            esac
        } &
        pid=$!
        bar_width=20
        percent=0
        while kill -0 "$pid" 2>/dev/null; do
            # Calculate the number of '#' and ' ' characters
            filled=$((percent * bar_width / 100))
            empty=$((bar_width - filled))
            bar=$(printf '%*s' "$filled" | tr ' ' '#')
            bar="$bar$(printf '%*s' "$empty")"
            printf "\rDownloading $1: %3d%% [%s] %s" "$percent" "$bar" "$dest"
            sleep 0.1
            percent=$((percent + 5))
            [ "$percent" -gt 100 ] && percent=100
        done
        wait "$pid"
        if [ $? -ne 0 ]; then
            die "Failed to download $src for $1"
        fi
        bar=$(printf '%*s' "$bar_width" | tr ' ' '#')
        printf "\rDownloading $1: 100%% [%s] %s\n" "$bar" "$dest"
        i=$((i + 1))
    done
    cd "$ppwd"
}

detect_build_system() {
    log "Detecting build system in $PWD..."
    if [ -f "meson.build" ]; then
        echo "meson"
    elif [ -f "CMakeLists.txt" ]; then
        echo "cmake"
    elif [ -f "autogen.sh" ]; then
        echo "autotools-autogen"
    elif [ -f "configure" ]; then
        echo "autotools"
    elif [ -f "Makefile" ] || [ -f "makefile" ]; then
        echo "make"
    else
        echo "unknown"
    fi
}

default_build() {
    pkg="$1"
    dest="$2"
    build_system=$(detect_build_system)

    log "Detected build system: $build_system for $pkg in $PWD"

    case "$build_system" in
        meson)
            meson setup build --prefix=/usr
            ninja -C build
            ninja -C build install DESTDIR="$dest"
            ;;
        cmake)
            mkdir -p build
            cd build
            cmake .. -DCMAKE_INSTALL_PREFIX=/usr
            make
            make install DESTDIR="$dest"
            cd ..
            ;;
        autotools-autogen)
            ./autogen.sh
            ./configure --prefix=/usr
            make
            make install DESTDIR="$dest"
            ;;
        autotools)
            ./configure --prefix=/usr
            make
            make install DESTDIR="$dest"
            ;;
        make)
            make
            make install DESTDIR="$dest"
            ;;
        *)
            die "Unsupported build system for $pkg: $build_system. Provide a build script."
            ;;
    esac
}

pkg_build() {
    pkg_find "$1"
    pkg_find_version "$1"
    cd "$repo_dir"
    pkg_verify "$1"
    pkg_source "$1"
    mkdir -p "$bld_dir/$1"
    cd "$bld_dir/$1"

    log "Initial contents of build directory ($PWD):"
    ls -la

    log "Extracting sources into build directory ($PWD)..."
    cd "$src_dir/$1"
    log "Contents of source directory ($PWD):"
    ls -la
    for src in *.tar.*; do
        if [ -f "$src" ]; then
            log "Extracting $src to $bld_dir/$1..."
            tar -C "$bld_dir/$1" -xvf "$src" || die "Failed to extract $src to $bld_dir/$1"
            break
        else
            die "No tarball found in $src_dir/$1"
        fi
    done

    cd "$bld_dir/$1"
    log "Contents of build directory after extraction ($PWD):"
    ls -la

    set +f
    src_dir=""
    log "Searching for build files in $PWD..."
    for dir in *; do
        if [ -d "$dir" ]; then
            log "Checking directory: $dir"
            cd "$dir" || continue
            log "Contents of $dir ($PWD):"
            ls -la
            if [ -f "meson.build" ] || \
               [ -f "CMakeLists.txt" ] || \
               [ -f "autogen.sh" ] || \
               [ -f "configure" ] || \
               [ -f "Makefile" ] || \
               [ -f "makefile" ]; then
                src_dir="$dir"
                log "Found build files in $dir"
                cd ..
                break
            fi
            cd ..
        else
            log "No directories found to check in $PWD"
        fi
    done
    set -f

    if [ -z "$src_dir" ]; then
        die "No source directory found with build files (meson.build, CMakeLists.txt, autogen.sh, configure, or Makefile) in $bld_dir/$1"
    fi

    cd "$src_dir"
    log "Building $1 in $PWD..."
    if [ -f "$repo_dir/patches" ]; then
        mkdir -p patches
        cp -r "$repo_dir/patches"/* patches/
        for patch in patches/*.patch; do
            [ -f "$patch" ] && patch -p1 < "$patch"
        done
    fi

    if [ -f "$repo_dir/build" ]; then
        if ! sh -e "$repo_dir/build" "$pkg_dir/$1"; then
            die "Build failed for $1. Check $repo_dir/build script and dependencies."
        fi
    else
        default_build "$1" "$pkg_dir/$1"
    fi

    cd "$pkg_dir/$1"
    find . -type f \( -path '*/bin/*' -o -path '*/sbin/*' \) -exec chmod +x {} +
    cd "$bld_dir/$1"
    tar -cf - -C "$pkg_dir/$1" . | case $LXPKG_COMPRESS in
        gz) gzip -9 ;;
        xz) xz -9 ;;
        zst) zstd -19 ;;
    esac > "$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS"
    cd "$ppwd"
}

pkg_etcsums() {
    log "$1" "Generating etcsums"
    [ -d "$pkg_dir/$1/etc" ] || return 0
    > "$pkg_dir/$1/$pkg_db/$1/etcsums"
    while read -r file; do
        case $file in /etc/*[!/])
            f="$pkg_dir/$1$file"
            [ -h "$f" ] && f=/dev/null
            sha256sum "$f" | awk '{print $1}' >> "$pkg_dir/$1/$pkg_db/$1/etcsums"
        esac
    done < "$pkg_dir/$1/$pkg_db/$1/manifest"
}

pkg_etc() {
    read -r sum_old <&3 2>/dev/null || sum_old=""
    f="$LXPKG_ROOT$file"
    [ -h "$f" ] && f=/dev/null
    sum_sys=$(sha256sum "$f" 2>/dev/null | awk '{print $1}') || sum_sys=""
    sum_new=$(sha256sum "$pkg_dir/$1$file" | awk '{print $1}')
    case "${sum_old:-null}${sum_sys}${sum_new}" in
        "${sum_new}${sum_sys}${sum_old}") return 1 ;;
        "${sum_old}${sum_old}${sum_old}"|\
        "${sum_old:-null}${sum_sys}${sum_sys}"|\
        "${sum_sys}${sum_old}"*) ;;
        *) warn "$1" "Saving $file as $file.new"; file="$file.new" ;;
    esac
}

pkg_fix_deps() {
    log "$1" "Detecting runtime dependencies"
    cd "$pkg_dir/$1/$pkg_db/$1"
    tmp_file="$pkg_dir/$1/depends-new"
    cp -f "$repo_dir/depends" "$tmp_file" 2>/dev/null || : > "$tmp_file"

    set +f
    while read -r file; do
        case $file in
            */bin/*|*/sbin/*|*/lib/*)
                [ -h "$pkg_dir/$1$file" ] && continue
                ldd_out=$(ldd "$pkg_dir/$1$file" 2>/dev/null) || continue
                echo "$ldd_out" | while read -r line; do
                    case $line in
                        *"=> /"*)
                            lib=${line##*=> }
                            lib=${lib%% *}
                            lib=${lib#"$LXPKG_ROOT"}
                            case $lib in
                                /lib/ld-*|/lib/lib[cm].so*|/lib/libpthread.so*) continue ;;
                            esac
                            owner=$(grep -l "^$lib$" "$sys_db"/*/manifest 2>/dev/null | head -n 1)
                            [ -n "$owner" ] || continue
                            owner=$(basename "$(dirname "$owner")")
                            [ "$owner" = "$1" ] && continue
                            grep -q "^$owner$" "$tmp_file" || echo "$owner" >> "$tmp_file"
                        ;;
                    esac
                done
        esac
    done < manifest
    set -f

    sort -u "$tmp_file" > "$pkg_dir/$1/depends-new-sorted"
    mv -f "$pkg_dir/$1/depends-new-sorted" "$repo_dir/depends"
    cp -f "$repo_dir/depends" "$pkg_dir/$1/$pkg_db/$1/depends"
}

pkg_strip() {
    log "$1" "Stripping binaries and libraries"
    [ "${LXPKG_STRIP:-1}" = "0" ] && return
    while read -r file; do
        case $file in
            */bin/*|*/sbin/*|*/lib/*)
                [ -h "$pkg_dir/$1$file" ] && continue
                case $(file "$pkg_dir/$1$file") in
                    *ELF*executable*|*ELF*shared\ object*)
                        strip -s "$pkg_dir/$1$file" 2>/dev/null || :
                    ;;
                esac
            ;;
        esac
    done < "$pkg_dir/$1/$pkg_db/$1/manifest"
}

pkg_conflicts() {
    log "$1" "Checking for package conflicts"
    mkdir -p "$pkg_dir/$1/$pkg_db"
    cd "$pkg_dir/$1"

    tmp_file="$pkg_dir/$1/conflicts"
    while read -r file; do
        case $file in *[!/])
            printf '%s\n' "$file"
        esac
    done < "$pkg_dir/$1/$pkg_db/$1/manifest" > "$tmp_file"

    set +f
    conflict_found=0
    for manifest in "$sys_db"/*/manifest; do
        [ -f "$manifest" ] || continue
        other_pkg=$(basename "$(dirname "$manifest")")
        [ "$other_pkg" = "$1" ] && continue
        if grep -qFxf "$tmp_file" "$manifest"; then
            conflict_found=1
            log "Conflict found between $1 and $other_pkg"
            break
        fi
    done
    set -f

    if [ "$conflict_found" -eq 1 ]; then
        if [ "${LXPKG_CHOICE:-0}" = "1" ]; then
            log "Converting conflicts to alternatives"
            while read -r file; do
                case $file in *[!/])
                    mkdir -p "$sys_ch"
                    conflict_name="$1${file//\//>}"
                    log "Moving $file to alternatives: $sys_ch/$conflict_name"
                    mv -f "$pkg_dir/$1$file" "$sys_ch/$conflict_name"
                    sed -i "s|^$file$|$cho_db/$conflict_name|" "$pkg_dir/$1/$pkg_db/$1/manifest"
                esac
            done < "$tmp_file"
            log "Conflicts converted to alternatives. Use 'lxpkg a' to manage."
        else
            die "Package $1 conflicts with another package. Run 'LXPKG_CHOICE=1 lxpkg i $1' to add as alternatives."
        fi
    fi
    rm -f "$tmp_file"
}

pkg_alternatives() {
    if [ "$1" = "-" ]; then
        while read -r pkg path; do
            pkg_swap "$pkg" "$path"
        done
    elif [ -n "$1" ]; then
        pkg_swap "$@"
    else
        set +f
        for alt in "$sys_ch/"*; do
            [ -e "$alt" ] || continue
            alt_name=$(basename "$alt")
            pkg=${alt_name%%>*}
            path=${alt_name#*>}
            path=${path//>/\/}
            printf '%s %s\n' "$pkg" "/$path"
        done
        set -f
    fi
}

pkg_swap() {
    [ -d "$sys_db/$1" ] || die "'$1' not found"
    conflict_name="$1${2//\//>}"
    [ -e "$sys_ch/$conflict_name" ] || die "Alternative '$1 $2' doesn't exist"

    if [ -e "$LXPKG_ROOT$2" ]; then
        other_pkg=$(grep -l "^$2$" "$sys_db"/*/manifest | head -n 1)
        other_pkg=$(basename "$(dirname "$other_pkg")")
        [ -n "$other_pkg" ] || die "File '$2' exists but isn't owned by any package"
        log "Swapping '$2' from '$other_pkg' to '$1'"
        other_conflict_name="$other_pkg${2//\//>}"
        mv -f "$LXPKG_ROOT$2" "$sys_ch/$other_conflict_name"
        sed -i "s|^$2$|$cho_db/$other_conflict_name|" "$sys_db/$other_pkg/manifest"
    fi

    mv -f "$sys_ch/$conflict_name" "$LXPKG_ROOT$2"
    sed -i "s|^$cho_db/$conflict_name$|$2|" "$sys_db/$1/manifest"
}

pkg_install() {
    pkg_find "$1"
    pkg_find_version "$1"
    pkg_cache "$1" || pkg_build "$1"
    cd "$repo_dir"

    mkdir -p "$pkg_dir/$1/$pkg_db/$1"
    if [ ! -f "$pkg_dir/$1/$pkg_db/$1/manifest" ]; then
        log "$1" "Generating manifest"
        (cd "$pkg_dir/$1" && find . -type f -o -type l | sed 's|^\./||' > "$pkg_dir/$1/$pkg_db/$1/manifest")
    fi

    pkg_fix_deps "$1"
    pkg_etcsums "$1"
    pkg_strip "$1"
    pkg_conflicts "$1"

    log "Installing to LXPKG_ROOT=$LXPKG_ROOT"
    log "Installing $1 version $repo_ver-$repo_rel..."
    while read -r file; do
        case $file in
            */)
                mkdir -p "$LXPKG_ROOT/$file" 2>/dev/null || :
                ;;
            *)
                case $file in
                    /etc/*[!/])
                        pkg_etc || continue
                        ;;
                    # Skip database files during the main installation loop
                    var/db/lxpkg/installed/*)
                        continue
                        ;;
                esac
                mkdir -p "$LXPKG_ROOT${file%/*}"
                src_file="$pkg_dir/$1/$file"
                dest_file="$LXPKG_ROOT/$file"
                if [ -f "$src_file" ]; then
                    cp -fv "$src_file" "$dest_file" || die "Failed to copy $src_file to $dest_file"
                else
                    warn "Source file $src_file not found, skipping"
                fi
                ;;
        esac
    done < "$pkg_dir/$1/$pkg_db/$1/manifest"

    # Now install the database files to the system database
    log "Recording $1 in package database..."
    mkdir -p "$sys_db/$1"
    printf '%s %s\n' "$repo_ver" "$repo_rel" > "$sys_db/$1/version"
    cp -f "$repo_dir/depends" "$sys_db/$1/depends" 2>/dev/null || :
    cp -f "$pkg_dir/$1/$pkg_db/$1/etcsums" "$sys_db/$1/etcsums" 2>/dev/null || :
    cp -f "$pkg_dir/$1/$pkg_db/$1/manifest" "$sys_db/$1/manifest" || die "Failed to copy manifest to $sys_db/$1/manifest"

    if [ -f "$repo_dir/post-install" ]; then
        log "Running post-install script for $1..."
        sh -e "$repo_dir/post-install" "$LXPKG_ROOT/"
    fi
    log "Installed $1 successfully."
    cd "$ppwd"
}

pkg_remove() {
    pkg_find "$1" "" -f "$sys_db"
    cd "$sys_db/$1"
    while read -r file; do
        if [ -f "$LXPKG_ROOT/$file" ]; then
            rm -f "$LXPKG_ROOT/$file"
        elif [ -d "$LXPKG_ROOT/$file" ]; then
            rmdir "$LXPKG_ROOT/$file" 2>/dev/null || true
        fi
    done < manifest
    rm -rf "$sys_db/$1"
    cd "$ppwd"
}

pkg_list() {
    set +f
    for pkg in "$sys_db/"*; do
        [ -d "$pkg" ] && printf '%s %s-%s\n' "${pkg##*/}" "$(cat "$pkg/version")"
    done
}

pkg_search() {
    if [ $# -eq 0 ]; then
        set +f
        for path in $LXPKG_PATH; do
            for pkg_path in $(find "$path" -maxdepth 2 -type d 2>/dev/null); do
                pkg_name=$(basename "$pkg_path")
                [ -f "$pkg_path/version" ] || continue
                read -r ver rel < "$pkg_path/version" 2>/dev/null || continue
                printf '%b * %b%-20s %bVersion:%b %-10s %bRepository:%b %s\n' \
                    "$c1" "$c4" "$pkg_name" "$c1" "$c3" "$ver-$rel" "$c1" "$c5" "$pkg_path"
            done
        done
    else
        for pkg; do
            if paths=$(pkg_find "$pkg" 1); then
                for path in $paths; do
                    read -r ver rel < "$path/version" 2>/dev/null || continue
                    pkg_name=$(basename "$path")
                    printf '%b * %b%-20s %bVersion:%b %-10s %bRepository:%b %s\n' \
                        "$c1" "$c4" "$pkg_name" "$c1" "$c3" "$ver-$rel" "$c1" "$c5" "$path"
                done
            else
                log "$pkg not found"
            fi
        done
    fi
}

pkg_update() {
    for repo in $LXPKG_PATH; do
        log "Updating repository $repo"
        if [ -d "$repo/.git" ]; then
            git -C "$repo" pull
            git -C "$repo" submodule update --remote --init -f
        fi
    done
    log "Run 'lxpkg U' to upgrade packages"
}

pkg_upgrade() {
    log "Checking for new package versions"
    set +f
    installed_found=0
    for pkg in "$sys_db/"*; do
        [ -d "$pkg" ] || continue
        installed_found=1
        set -f
        pkg_find_version "${pkg##*/}" "" "" "$sys_db"
        pkg_find_version "${pkg##*/}"
        case $repo_dir in */var/db/lxpkg/installed/*)
            _repo_orp="$_repo_orp$newline${pkg##*/}"
        esac
        equ "$ver_pre-$rel_pre" "$repo_ver-$repo_rel" || {
            set -- "$@" "${pkg##*/}"
            printf '%s %s => %s\n' "${pkg##*/}" "$ver_pre-$rel_pre" "$repo_ver-$repo_rel"
        }
    done
    case $_repo_orp in *?*)
        warn "Packages without repository$_repo_orp"
    esac
    build_install=0
    prefer_cache=1
    ! contains "$*" lxpkg || {
        log "Detected package manager update"
        log "The package manager will be updated first"
        prompt
        pkg_build_all lxpkg
        log "Updated the package manager"
        log "Re-run 'lxpkg update' to update your system"
        return 0
    }
    if [ "$installed_found" -eq 0 ]; then
        log "No installed packages found. Nothing to upgrade."
        return 0
    fi
    for _ do
        pkg_order "$@"
        set -- $order
        prompt "Packages to update ($#): $*"
        pkg_build_all "$@"
        log "Updated all packages"
        return 0
    done
    log "Nothing to do"
}

pkg_build_all() {
    for pkg; do
        pkg_resolve_deps "$pkg"
        pkg_build "$pkg"
        pkg_install "$pkg"
    done
}

pkg_depends_list() {
    pkg_find "$1"
    if [ -f "$repo_dir/depends" ]; then
        log "Dependencies for $1:"
        cat "$repo_dir/depends" | while read -r dep make; do
            [ "$make" = "make" ] || printf '%b - %b%s%b\n' "$c1" "$c4" "$dep" "$c3"
        done
    else
        log "$1 has no explicit dependencies"
    fi
}

pkg_manifest() {
    pkg_find "$1" "" -f "$sys_db"
    log "Files installed by $1:"
    while read -r file; do
        printf '%b - %b%s%b\n' "$c1" "$c5" "$LXPKG_ROOT/$file" "$c3"
    done < "$sys_db/$1/manifest"
}

pkg_owns() {
    [ -n "$1" ] || die "Usage: lxpkg o /path/to/file"
    file="$1"
    # Resolve symlinks
    case $file in
        /*)
            cd -P "${LXPKG_ROOT:-/}${file%/*}" || die "Cannot access directory for $file"
            [ "$PWD" = / ] && LXPKG_ROOT=
        ;;
        */*)
            cd -P "${file%/*}" || die "Cannot access directory for $file"
        ;;
        *)
            cd -P . || die "Cannot access current directory"
        ;;
    esac
    search_path="${PWD#"$LXPKG_ROOT"}/${file##*/}"
    [ -f "$PWD/${file##*/}" ] || die "File $file does not exist"
    set +f
    owner=""
    for manifest in "$sys_db"/*/manifest; do
        [ -f "$manifest" ] || continue
        if grep -qFx "$search_path" "$manifest"; then
            owner=$(basename "$(dirname "$manifest")")
            break
        fi
    done
    set -f
    if [ -n "$owner" ]; then
        log "File $file is owned by $owner"
    else
        log "File $file is not owned by any package"
    fi
}

pkg_orphans() {
    log "Checking for orphaned packages..."
    set +f
    core_pkgs="lxpkg gcc musl"
    orphans=""
    for pkg in "$sys_db/"*; do
        [ -d "$pkg" ] || continue
        pkg_name=${pkg##*/}
        contains "$core_pkgs" "$pkg_name" && continue
        is_dep=0
        for other_pkg in "$sys_db/"*; do
            [ -d "$other_pkg" ] || continue
            [ "${other_pkg##*/}" = "$pkg_name" ] && continue
            if [ -f "$other_pkg/depends" ] && grep -q "^$pkg_name$" "$other_pkg/depends"; then
                is_dep=1
                break
            fi
        done
        if [ "$is_dep" -eq 0 ]; then
            orphans="$orphans $pkg_name"
        fi
    done
    set -f
    if [ -z "$orphans" ]; then
        log "No orphaned packages found"
    else
        for pkg in $orphans; do
            printf '%b * %b%s%b\n' "$c1" "$c4" "$pkg" "$c3"
        done
    fi
}

pkg_revdepends() {
    pkg_find "$1" "" -f "$sys_db"
    log "Checking for packages that depend on $1..."
    set +f
    found=0
    for other_pkg in "$sys_db/"*; do
        [ -d "$other_pkg" ] || continue
        other_pkg_name=${other_pkg##*/}
        [ "$other_pkg_name" = "$1" ] && continue
        if [ -f "$other_pkg/depends" ] && grep -q "^$1$" "$other_pkg/depends"; then
            printf '%b * %b%s%b\n' "$c1" "$c4" "$other_pkg_name" "$c3"
            found=1
        fi
    done
    set -f
    [ "$found" -eq 0 ] && log "No installed packages depend on $1"
}

pkg_reporevdepends() {
    [ -n "$1" ] || die "Usage: lxpkg rr pkg"
    pkg="$1"
    log "Checking for repository packages that depend on $pkg..."
    set +f
    found=0
    for repo_path in $LXPKG_PATH; do
        for depends in "$repo_path"/*/depends; do
            [ -f "$depends" ] || continue
            repo_pkg=$(basename "$(dirname "$depends")")
            if grep -q "^$pkg$" "$depends"; then
                printf '%b * %b%s%b (in %s)\n' "$c1" "$c4" "$repo_pkg" "$c3" "$repo_path"
                found=1
            fi
        done
    done
    set -f
    [ "$found" -eq 0 ] && log "No repository packages depend on $pkg"
}

pkg_size() {
    pkg_find "$1" "" -f "$sys_db"
    log "Calculating size of $1..."
    total_size=0
    while read -r file; do
        case $file in */) continue; esac
        size=$(du -sk "$LXPKG_ROOT/$file" 2>/dev/null | awk '{print $1}' || echo 0)
        total_size=$((total_size + size))
        case ${#size} in
            [0-3]) hum="$size KB" ;;
            [4-6]) hum="$((size / 1024)) MB" ;;
            [7-9]) hum="$((size / 1024 / 1024)) GB" ;;
            *)     hum="$size B" ;;
        esac
        printf '%b - %b%-10s %b%s%b\n' "$c1" "$c2" "$hum" "$c5" "$LXPKG_ROOT/$file" "$c3"
    done < "$sys_db/$1/manifest"
    case ${#total_size} in
        [0-3]) hum="$total_size KB" ;;
        [4-6]) hum="$((total_size / 1024)) MB" ;;
        [7-9]) hum="$((total_size / 1024 / 1024)) GB" ;;
        *)     hum="$total_size B" ;;
    esac
    log "Total size for $1: $hum"
}

create_tmp_dirs() {
    cache_dir=/tmp/lxpkg-$LOGNAME-$LXPKG_PID/cache
    src_dir=/tmp/lxpkg-$LOGNAME-$LXPKG_PID/src
    bld_dir=/tmp/lxpkg-$LOGNAME-$LXPKG_PID/build
    pkg_dir=/tmp/lxpkg-$LOGNAME-$LXPKG_PID/pkg
    mkdir -p "$cache_dir" "$src_dir" "$bld_dir" "$pkg_dir"
    sys_db=${LXPKG_ROOT:-/}var/db/lxpkg/installed
    sys_ch=$LXPKG_ROOT/${cho_db:=var/db/lxpkg/choices}
    pkg_db=var/db/lxpkg/installed
}

trap_on() {
    trap 'rm -rf /tmp/lxpkg-$LOGNAME-$LXPKG_PID; exit' INT TERM EXIT
}

args() {
    sys_db=${LXPKG_ROOT:-/}var/db/lxpkg/installed
    case $1 in
        a|alternatives) shift; pkg_alternatives "$@";;
        b|build) shift; for pkg; do pkg_build "$pkg"; done ;;
        c|checksum) shift; for pkg; do pkg_checksums "$pkg"; done ;;
        d|depends) shift; for pkg; do pkg_depends_list "$pkg"; done ;;
        i|install) shift; for pkg; do pkg_install "$pkg"; done ;;
        m|manifest) shift; for pkg; do pkg_manifest "$pkg"; done ;;
        o|owns) shift; for file; do pkg_owns "$file"; done ;;
        O|orphans) shift; pkg_orphans ;;
        r|remove) shift; for pkg; do pkg_remove "$pkg"; done ;;
        R|revdepends) shift; for pkg; do pkg_revdepends "$pkg"; done ;;
        rr|reporevdepends) shift; for pkg; do pkg_reporevdepends "$pkg"; done ;;
        s|search) shift; pkg_search "$@";;
        S|size) shift; for pkg; do pkg_size "$pkg"; done ;;
        l|list) shift; pkg_list ;;
        u|update) shift; pkg_update ;;
        U|upgrade) shift; pkg_upgrade ;;
        v|version) log "lxpkg version 1.0.0" ;;
        *) die "Usage: lxpkg [a|b|c|d|i|m|o|O|r|R|rr|s|S|l|u|U|v] [pkg...]" \
               "Commands:" \
               "  a, alternatives   - List and swap alternatives" \
               "  b, build         - Build packages" \
               "  c, checksum      - Generate checksums" \
               "  d, depends       - List package dependencies" \
               "  i, install       - Install packages" \
               "  m, manifest      - Show package manifest" \
               "  o, owns          - Show which package owns a file" \
               "  O, orphans       - List orphaned packages" \
               "  r, remove        - Remove packages" \
               "  R, revdepends    - List reverse dependencies (installed)" \
               "  rr, reporevdepends - List reverse dependencies (repository)" \
               "  s, search        - Search for packages" \
               "  S, size          - Show package size" \
               "  l, list          - List installed packages" \
               "  u, update        - Update repositories" \
               "  U, upgrade       - Upgrade packages" \
               "  v, version       - Show package manager version" ;;
    esac
}

main() {
    set -ef
    if [ -f "/etc/lxpkg.conf" ]; then
        . /etc/lxpkg.conf
    fi
    : "${LXPKG_PATH:=/usr/src/lxpkg/repo}"
    equ "$LXPKG_COLOR" 0 || ! [ -t 2 ] || {
        c1='\033[3;90m'
        c2='\033[3;90m'
        c3='\033[m'
        c4='\033[3;36m'
        c5='\033[3;90m'
    }
    ppwd=$PWD
    newline="
"
    : "${LXPKG_COMPRESS:=gz}"
    : "${LXPKG_PID:=$$}"
    : "${LOGNAME:?POSIX requires LOGNAME be set}"
    cmd_su=${LXPKG_SU:-"$(
        command -v ssu  ||
        command -v sudo ||
        command -v doas ||
        command -v su
    )"} || cmd_su=su
    cmd_elf=${LXPKG_ELF:-"$(
        command -v readelf      ||
        command -v eu-readelf   ||
        command -v llvm-readelf ||
        command -v ldd
    )"} || cmd_elf=ldd
    cmd_b3=${LXPKG_B3:-"$(command -v b3sum)"} || die "No blake3 utility found (b3sum required)"
    cmd_sha=${LXPKG_CHK:-"$(
        command -v openssl   ||
        command -v sha256sum ||
        command -v sha256    ||
        command -v shasum    ||
        command -v digest
    )"} || warn "No sha256 utility found"
    cmd_get=${LXPKG_GET:-"$(
        command -v aria2c ||
        command -v axel   ||
        command -v curl   ||
        command -v wget   ||
        command -v wget2
    )"} || die "No download utility found (aria2c, axel, curl, wget, wget2)"
    time=${_LXPKG_DATE:-"$(date +%Y-%m-%d-%H:%M)"}
    create_tmp_dirs
    trap_on
    args "$@"
}

main "$@"
