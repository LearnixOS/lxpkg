#!/bin/sh
# lxpkg: Simple package manager for lxos (https://learnixos.github.io)
# Version: 1.2.4

# Exit on errors
set -e

# ANSI color codes
c_reset='\033[m'         # Reset
c_grey='\033[3;90m'      # Italic grey (steps)
c_green='\033[1;32m'     # Bold green (success)
c_cyan='\033[1;36m'      # Bold cyan (package names)
c_purple='\033[3;35m'    # Purple (paths)
c_yellow='\033[1;33m'    # Bold yellow (warnings)
c_red='\033[1;31m'       # Bold red (errors)
c_blue='\033[1;34m'      # Bold blue (installation)

# Logging functions
log() { printf '%b%s %b%s%b\n' "$c_grey" "==>" "$c_green" "$*" "$c_reset"; }
warn() { printf '%b%s %b%s%b\n' "$c_yellow" "WARNING:" "$c_reset" "$*" "$c_reset" >&2; }
die() { printf '%b%s %b%s%b\n' "$c_red" "ERROR:" "$c_reset" "$*" "$c_reset" >&2; exit 1; }

# Utility functions
ok() { [ -e "$1" ] || return 1; }
equ() { [ "$1" = "$2" ]; }
contains() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }
prompt() {
    printf '%b%s%b\n' "$c_green" "$*" "$c_reset"
    printf '%b%s%b' "$c_grey" "Continue? [Enter/Ctrl+C] " "$c_reset"
    read -r _
}

# Create default /etc/lxpkg.conf
create_default_conf() {
    local conf_file="/etc/lxpkg.conf"
    if [ ! -f "$conf_file" ]; then
        log "Creating default configuration file at $conf_file"
        printf '# lxpkg configuration file\n' > "$conf_file"
        printf 'LXPKG_PATH=/usr/src/lxpkg/repo\n' >> "$conf_file"
        printf 'LXPKG_COMPRESS=xz\n' >> "$conf_file"
        printf 'LXPKG_SKIP_CHECKSUMS=0\n' >> "$conf_file"
        printf 'LXPKG_STRIP=1\n' >> "$conf_file"
        printf 'LXPKG_COLOR=1\n' >> "$conf_file"
    fi
}

# Check for pre-installed system packages
pkg_check_system() {
    local pkg="$1"
    case "$pkg" in
        glibc)
            for lib in /lib/libc.so* /usr/lib/libc.so* /lib64/libc.so* /usr/lib64/libc.so*; do
                [ -f "$lib" ] && { log "$pkg detected in $lib, skipping"; return 0; }
            done
            ;;
        xorg-server)
            [ -f "/usr/bin/Xorg" ] || [ -f "/usr/lib/xorg/Xorg" ] && { log "$pkg detected, skipping"; return 0; }
            ;;
        *)
            if [ -d "$sys_db/$pkg" ] && [ -f "$sys_db/$pkg/version" ]; then
                read -r ver rel < "$sys_db/$pkg/version" 2>/dev/null
                log "$pkg version $ver-$rel already installed, skipping"
                return 0
            fi
            ;;
    esac
    return 1
}

# Find package
pkg_find() { _pkg_find "$@" || die "Package '$1' not found in repositories"; }

_pkg_find() {
    local pkg="$1" find_type="${2:-}" test_type="${3:-}" search_path="${4:-$LXPKG_PATH}"
    IFS=:
    set +f
    local found=0
    for path in $search_path "${test_type:-$sys_db}"; do
        [ -d "$path" ] || continue
        for section in "$path"/*; do
            [ -d "$section" ] || continue
            for pkg_path in "$section"/*; do
                if [ -d "$pkg_path" ] && [ -f "$pkg_path/version" ] && [ "$(basename "$pkg_path")" = "$pkg" ]; then
                    found=1
                    repo_dir="$pkg_path"
                    repo_name="$pkg"
                    test "${test_type:--d}" "$pkg_path" && set -- "$@" "$pkg_path"
                fi
            done
        done
    done
    unset IFS
    set -f
    case $find_type-$# in
        *-4) return 1 ;;
        -*) : ;;
        *) shift 4; printf '%s\n' "$@"
    esac
    [ "$found" -eq 1 ] || return 1
}

# Find package version
pkg_find_version() {
    read -r ver_pre rel_pre < "$repo_dir/version" 2>/dev/null || { ver_pre=; rel_pre=; }
    repo_ver=$ver_pre
    repo_rel=${rel_pre:-0}  # Default to '0' if release is empty
}

# Check package cache
pkg_cache() {
    pkg_find_version "$1"
    local cache_file="$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS"
    if [ -f "$cache_file" ]; then
        log "Found cached package $1@$repo_ver-$repo_rel"
        mkdir -p "$pkg_dir/$1"
        tar -C "$pkg_dir/$1" -xvf "$cache_file" >/dev/null
        return 0
    fi
    return 1
}

# Get checksums
pkg_checksums() {
    pkg_find "$1"
    [ -f "$repo_dir/checksums" ] && { log "Found checksums file at $repo_dir/checksums"; cat "$repo_dir/checksums"; } || { warn "No checksums found for $1"; return 1; }
}

# Verify checksums using b3sum
pkg_verify() {
    [ "$LXPKG_SKIP_CHECKSUMS" = 1 ] && { log "Skipping checksum verification for $1"; return 0; }
    pkg_find "$1"
    [ -f "$repo_dir/checksums" ] || { warn "Checksum file missing at $repo_dir/checksums for $1"; return 1; }
    local checksum_lines=$(wc -l < "$repo_dir/checksums")
    [ "$checksum_lines" -eq 0 ] && { warn "Checksum file $repo_dir/checksums is empty for $1"; return 1; }
    pkg_source "$1"  # Download sources first to ensure $src_dir/$1 exists
    cd "$src_dir/$1" || die "Failed to change to source directory $src_dir/$1"
    local i=1
    local valid_checksums=0
    pkg_checksums "$1" | while read -r sum file; do
        if [ -z "$sum" ] || [ -z "$file" ]; then
            warn "Malformed checksum entry #$i in $repo_dir/checksums for $1 (expected: <hash> <filename>, got: '$sum $file')"
            return 1
        fi
        [ -f "$file" ] || { warn "Source file $file not found in $src_dir/$1 for $1"; return 1; }
        log "Verifying checksum for $file in $1"
        b3sum "$file" 2>/dev/null | { read -r b3 _; [ "$b3" = "$sum" ] || die "Checksum mismatch for $file in $1 (expected $sum, got $b3)"; }
        valid_checksums=$((valid_checksums + 1))
        i=$((i + 1))
    done
    [ "$valid_checksums" -eq 0 ] && { warn "No valid checksum entries found in $repo_dir/checksums for $1"; return 1; }
    log "Checksum verification passed for $1"
    cd "$ppwd"
}

# Get sources
pkg_sources() {
    pkg_find "$1"
    [ -f "$repo_dir/sources" ] && cat "$repo_dir/sources" || { warn "No sources file found for $1"; return 1; }
}

# Get dependencies
pkg_depends() {
    pkg_find "$1"
    [ -f "$repo_dir/depends" ] && cat "$repo_dir/depends" | while read -r dep make; do [ "$make" = "make" ] || printf '%s\n' "$dep"; done
}

# Check if installed
pkg_is_installed() { [ -d "$sys_db/$1" ]; }

# Resolve dependencies
pkg_resolve_deps() {
    unset _seen_deps _dep_stack
    log "Resolving dependencies for $@..."
    _resolve_deps "$@" || die "Failed to resolve dependencies for $@"
}

_resolve_deps() {
    for pkg in "$@"; do
        contains "$_seen_deps" "$pkg" && continue
        contains "$_dep_stack" "$pkg" && { warn "Circular dependency detected involving $pkg"; continue; }
        _dep_stack="$_dep_stack $pkg"
        pkg_find "$pkg" || die "Dependency $pkg not found in repository"
        if [ -f "$repo_dir/depends" ]; then
            for dep in $(pkg_depends "$pkg"); do
                if ! pkg_is_installed "$dep"; then
                    log "Installing missing dependency: $dep"
                    _resolve_deps "$dep"
                    pkg_build "$dep"
                    pkg_install "$dep"
                fi
            done
        fi
        _seen_deps="$_seen_deps $pkg"
        _dep_stack=${_dep_stack% $pkg}
    done
}

# Order packages by dependencies
pkg_order() {
    unset _seen
    order=""
    _pkg_order "$@"
    printf '%s\n' $order
}

_pkg_order() {
    for pkg; do
        contains "$_seen" "$pkg" && continue
        _seen="$_seen $pkg"
        for dep in $(pkg_depends "$pkg"); do
            _pkg_order "$dep"
        done
        order="$order $pkg"
    done
}

# Download sources
pkg_source() {
    pkg_find "$1"
    mkdir -p "$src_dir/$1"
    cd "$src_dir/$1"
    set +f
    local i=1
    [ -f "$repo_dir/sources" ] || { warn "No sources file found for $1 at $repo_dir/sources"; return 1; }
    pkg_sources "$1" | while read -r src dest; do
        log "Processing source #$i: $src"
        case $src in *::*) src=${src#*::}; src=${src##* } ;; *) src=${src##* } ;; esac
        case $dest in */*) mkdir -p "${dest%/*}" ;; esac
        dest=${dest:-${src##*/}}
        [ -f "$dest" ] && { log "Source $dest already exists, skipping download"; i=$((i + 1)); continue; }
        log "Downloading $1: $src to $dest..."
        local download_success=0
        if command -v pv >/dev/null 2>&1; then
            case $cmd_get in
                *curl) content_length=$(curl -sI "$src" | grep -i Content-Length | awk '{print $2}' | tr -d '\r'); curl -fL "$src" | pv -s "${content_length:-0}" > "$dest" && download_success=1 ;;
                *wget*) content_length=$(wget -q --spider "$src" 2>&1 | grep -i Length | awk '{print $2}' | tr -d '[]'); wget -O - "$src" | pv -s "${content_length:-0}" > "$dest" && download_success=1 ;;
                *) curl -fL "$src" > "$dest" && download_success=1 ;;
            esac
        else
            case $cmd_get in
                *aria2c) aria2c -x 16 -s 16 -o "$dest" "$src" >/dev/null 2>&1 && download_success=1 ;;
                *axel) axel -n 10 -o "$dest" "$src" >/dev/null 2>&1 && download_success=1 ;;
                *curl) curl -fLo "$dest" "$src" >/dev/null 2>&1 && download_success=1 ;;
                *wget*) wget -O "$dest" "$src" >/dev/null 2>&1 && download_success=1 ;;
            esac
        fi
        [ $download_success -eq 0 ] && { warn "Failed to download $src for $1 to $dest"; die "Download failed for source #$i of $1"; }
        log "Downloaded $1: $dest successfully"
        i=$((i + 1))
    done
    cd "$ppwd"
}

# Detect build system
detect_build_system() {
    [ -f "meson.build" ] && echo "meson" && return
    [ -f "CMakeLists.txt" ] && echo "cmake" && return
    [ -f "autogen.sh" ] && echo "autotools-autogen" && return
    [ -f "configure" ] && echo "autotools" && return
    [ -f "Makefile" ] || [ -f "makefile" ] && echo "make" && return
    echo "unknown"
}

# Default build
default_build() {
    local pkg="$1" dest="$2" build_system=$(detect_build_system) jobs=$(nproc 2>/dev/null || echo 4)
    log "Detected build system: $build_system for $pkg in $PWD"
    case "$build_system" in
        meson) meson setup build --prefix=/usr; ninja -C build -j"$jobs"; ninja -C build install DESTDIR="$dest" ;;
        cmake) mkdir -p build; cd build; cmake .. -DCMAKE_INSTALL_PREFIX=/usr; make -j"$jobs"; make install DESTDIR="$dest"; cd .. ;;
        autotools-autogen) ./autogen.sh; ./configure --prefix=/usr; make -j"$jobs"; make install DESTDIR="$dest" ;;
        autotools) ./configure --prefix=/usr; make -j"$jobs"; make install DESTDIR="$dest" ;;
        make) make -j"$jobs"; make install DESTDIR="$dest" ;;
        *) die "Unsupported build system for $pkg: $build_system" ;;
    esac
}

# Build package
pkg_build() {
    pkg_find "$1"
    pkg_find_version "$1"
    cd "$repo_dir"
    pkg_verify "$1"
    pkg_source "$1"
    mkdir -p "$bld_dir/$1"
    cd "$bld_dir/$1"
    log "Extracting sources into build directory ($PWD)..."
    cd "$src_dir/$1"
    local extracted=0
    set +f
    for src in *.tar.* *.tgz *.zip *.gz *.bz2 *.xz; do
        if [ -f "$src" ]; then
            log "Extracting $src to $bld_dir/$1..."
            case "$src" in
                *.tar.*|*.tgz) tar -C "$bld_dir/$1" -xvf "$src" || die "Failed to extract $src" ;;
                *.zip) unzip -q "$src" -d "$bld_dir/$1" || die "Failed to extract $src" ;;
                *.gz|*.bz2|*.xz) tar -C "$bld_dir/$1" -xvf "$src" 2>/dev/null || { log "Single file $src, copying"; cp "$src" "$bld_dir/$1/"; } ;;
            esac
            extracted=1
            break
        fi
    done
    set -f
    if [ $extracted -eq 0 ]; then
        log "No archives found in $src_dir/$1, checking files..."
        for src in *; do
            if [ -f "$src" ]; then
                log "Copying $src to $bld_dir/$1..."
                cp -r "$src" "$bld_dir/$1/" || die "Failed to copy $src"
                extracted=1
                break
            fi
        done
    fi
    [ $extracted -eq 0 ] && die "No sources found in $src_dir/$1"
    cd "$bld_dir/$1"
    set +f
    local src_dir=""
    for dir in *; do
        if [ -d "$dir" ]; then
            cd "$dir" || continue
            if [ -f "meson.build" ] || [ -f "CMakeLists.txt" ] || [ -f "autogen.sh" ] || [ -f "configure" ] || [ -f "Makefile" ] || [ -f "makefile" ]; then
                src_dir="$dir"
                cd ..
                break
            fi
            cd ..
        fi
    done
    set -f
    src_dir=${src_dir:-.}
    cd "$src_dir"
    log "Building $1 in $PWD..."
    if [ -f "$repo_dir/patches" ]; then
        mkdir -p patches
        cp -r "$repo_dir/patches"/* patches/
        for patch in patches/*.patch; do [ -f "$patch" ] && patch -p1 < "$patch"; done
    fi
    if [ -f "$repo_dir/build" ]; then
        sh -e "$repo_dir/build" "$pkg_dir/$1" || die "Build failed for $1"
    else
        default_build "$1" "$pkg_dir/$1"
    fi
    cd "$pkg_dir/$1"
    find . -type f \( -path '*/bin/*' -o -path '*/sbin/*' \) -exec chmod +x {} +
    cd "$bld_dir/$1"
    tar -cf - -C "$pkg_dir/$1" . | case $LXPKG_COMPRESS in
        gz) gzip -9 ;;
        xz) xz -9 ;;
        zst) zstd -19 ;;
    esac > "$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS"
    cd "$ppwd"
}

# Generate etcsums
pkg_etcsums() {
    local sums=$(mktemp)
    find "$pkg_dir/$1/etc" -type f 2>/dev/null | while read -r file; do
        file=${file#"$pkg_dir/$1/"}
        [ -f "$LXPKG_ROOT/$file" ] && sha256sum "$LXPKG_ROOT/$file" | sed "s|$LXPKG_ROOT/||" >> "$sums"
    done
    [ -s "$sums" ] && mv "$sums" "$pkg_dir/$1/$pkg_db/$1/etcsums" || rm -f "$sums"
}

# Handle /etc files
pkg_etc() {
    [ -f "$sys_db/$1/etcsums" ] && grep -Fx "$file" "$sys_db/$1/etcsums" >/dev/null && return 0
    [ -f "$LXPKG_ROOT/$file" ] && { mv "$LXPKG_ROOT/$file" "$LXPKG_ROOT/$file.lxpkgnew"; return 0; }
    return 1
}

# Fix runtime dependencies
pkg_fix_deps() {
    [ -f "$repo_dir/depends" ] || return 0
    while read -r dep; do
        [ -z "$dep" ] && continue
        case $dep in *'|'*) for alt_dep in $dep; do case $alt_dep in *'|'*) continue ;; *) dep=$alt_dep; break ;; esac; done ;; esac
        pkg_check_system "$dep" || { log "Installing dependency $dep for $1"; pkg_install "$dep"; }
    done < "$repo_dir/depends"
}

# Strip binaries
pkg_strip() {
    log "$1: Stripping binaries and libraries"
    [ "${LXPKG_STRIP:-1}" = "0" ] && return
    find "$pkg_dir/$1" \( -path '*/bin/*' -o -path '*/lib/*' \) -type f -exec strip --strip-unneeded {} \; 2>/dev/null || :
}

# Check conflicts
pkg_conflicts() {
    log "$1: Checking for package conflicts"
    while read -r file; do
        case $file in */ | var/db/lxpkg/installed/*) continue ;; esac
        if [ -e "$LXPKG_ROOT/$file" ] && [ ! -d "$LXPKG_ROOT/$file" ]; then
            for pkg in "$sys_db/"*; do
                [ -f "$pkg/manifest" ] || continue
                grep -Fx "$file" "$pkg/manifest" >/dev/null && die "File $file from $1 conflicts with ${pkg##*/}"
            done
        fi
    done < "$pkg_dir/$1/$pkg_db/$1/manifest"
}

# Manage alternatives
pkg_alternatives() {
    if [ "$1" = "-" ]; then
        while read -r pkg path; do pkg_swap "$pkg" "$path"; done
    elif [ -n "$1" ]; then
        pkg_swap "$@"
    else
        set +f
        for alt in "$sys_ch/"*; do
            [ -e "$alt" ] || continue
            alt_name=$(basename "$alt")
            pkg=${alt_name%%>*}
            path=${alt_name#*>}
            path=${path//>/\/}
            printf '%s %s\n' "$pkg" "/$path"
        done
        set -f
    fi
}

# Swap alternatives
pkg_swap() {
    [ -d "$sys_db/$1" ] || die "'$1' not found"
    local conflict_name="$1${2//\//>}"
    [ -e "$sys_ch/$conflict_name" ] || die "Alternative '$1 $2' doesn't exist"
    if [ -e "$LXPKG_ROOT$2" ]; then
        other_pkg=$(grep -l "^$2$" "$sys_db"/*/manifest | head -n 1)
        other_pkg=$(basename "$(dirname "$other_pkg")")
        [ -n "$other_pkg" ] || die "File '$2' exists but isn't owned by any package"
        log "Swapping '$2' from '$other_pkg' to '$1'"
        other_conflict_name="$other_pkg${2//\//>}"
        mv -f "$LXPKG_ROOT$2" "$sys_ch/$other_conflict_name"
        sed -i "s|^$2$|$cho_db/$other_conflict_name|" "$sys_db/$other_pkg/manifest"
    fi
    mv -f "$sys_ch/$conflict_name" "$LXPKG_ROOT$2"
    sed -i "s|^$cho_db/$conflict_name$|$2|" "$sys_db/$1/manifest"
}

# Install package
pkg_install() {
    pkg_find "$1"
    pkg_find_version "$1"
    pkg_check_system "$1" && return 0
    local install_root="${BOOTSTRAP_LXPKG:-$LXPKG_ROOT}"
    log "Preparing to install $1 version $repo_ver-$repo_rel to $install_root"
    
    # Validate checksums file before proceeding
    if [ -f "$repo_dir/checksums" ]; then
        local checksum_lines=$(wc -l < "$repo_dir/checksums")
        if [ "$checksum_lines" -eq 0 ]; then
            warn "Checksum file $repo_dir/checksums is empty for $1"
            [ "$LXPKG_SKIP_CHECKSUMS" = 1 ] || die "Cannot proceed without valid checksums"
        fi
    else
        warn "Checksum file missing at $repo_dir/checksums for $1"
        [ "$LXPKG_SKIP_CHECKSUMS" = 1 ] || die "Cannot proceed without checksums file"
    fi

    # Attempt to use cached package or build
    log "Checking for cached package $1@$repo_ver-$repo_rel"
    pkg_cache "$1" || {
        log "No cache found, building $1"
        pkg_build "$1" || die "Build failed for $1"
    }

    cd "$repo_dir"
    mkdir -p "$pkg_dir/$1/$pkg_db/$1"
    [ -f "$pkg_dir/$1/$pkg_db/$1/manifest" ] || {
        log "$1: Generating manifest"
        (cd "$pkg_dir/$1" && find . -type f -o -type l | sed 's|^\./||' > "$pkg_dir/$1/$pkg_db/$1/manifest")
    }

    # Fix dependencies
    pkg_fix_deps "$1"

    # Generate etcsums and strip binaries
    pkg_etcsums "$1"
    pkg_strip "$1"
    pkg_conflicts "$1"

    # Install files
    log "Installing $1 version $repo_ver-$repo_rel"
    local file_count=$(wc -l < "$pkg_dir/$1/$pkg_db/$1/manifest")
    local i=0
    while read -r file; do
        i=$((i + 1))
        local percent=$((i * 100 / file_count))
        printf '\r%b%s %bInstalling %s: %3d%% [%s]%b' "$c_grey" "==>" "$c_grey" "$1" "$percent" "$(printf '%*s' "$((percent / 5))" | tr ' ' '#')" "$c_reset"
        case $file in
            */) mkdir -p "$install_root/$file" 2>/dev/null || : ;;
            *)
                case $file in
                    /etc/*[!/]) pkg_etc || continue ;;
                    var/db/lxpkg/installed/*) continue ;;
                esac
                mkdir -p "$install_root${file%/*}"
                src_file="$pkg_dir/$1/$file"
                dest_file="$install_root/$file"
                if [ -f "$src_file" ]; then
                    cp -f "$src_file" "$dest_file" || warn "Failed to install $src_file to $dest_file"
                else
                    warn "Source file $src_file not found, skipping"
                fi
                ;;
        esac
    done < "$pkg_dir/$1/$pkg_db/$1/manifest"
    printf '\r%b%s %bInstalled %s: %3d%% [%-20s]%b\n' "$c_grey" "==>" "$c_grey" "$1" 100 "$(printf '%*s' 20 | tr ' ' '#')" "$c_reset"

    # Record in package database
    log "Recording $1 in package database at $sys_db/$1"
    mkdir -p "$sys_db/$1"
    # Use sed for POSIX-compatible character filtering
    clean_ver=$(printf '%s' "$repo_ver" | sed 's/[^0-9a-zA-Z.-]//g')
    clean_rel=$(printf '%s' "$repo_rel" | sed 's/[^0-9a-zA-Z.-]//g')
    if [ -z "$clean_ver" ]; then
        die "Invalid version ($repo_ver) for $1"
    fi
    # Allow empty clean_rel, default to '0' for consistency
    clean_rel=${clean_rel:-0}
    printf '%s %s\n' "$clean_ver" "$clean_rel" > "$sys_db/$1/version" || die "Failed to write version file for $1"
    cp -f "$repo_dir/depends" "$sys_db/$1/depends" 2>/dev/null || :
    cp -f "$pkg_dir/$1/$pkg_db/$1/etcsums" "$sys_db/$1/etcsums" 2>/dev/null || :
    cp -f "$pkg_dir/$1/$pkg_db/$1/manifest" "$sys_db/$1/manifest" || die "Failed to copy manifest for $1"

    # Run post-install script if present
    [ -f "$repo_dir/post-install" ] && {
        log "Running post-install script for $1"
        sh -e "$repo_dir/post-install" "$install_root/" || warn "Post-install script failed for $1"
    }

    log "Installed $1 successfully"
}

# Remove package
pkg_remove() {
    local pkg="$1" sys_db="/var/db/lxpkg/installed"
    [ -d "$sys_db/$pkg" ] || die "Package '$pkg' not found in system"
    [ -f "$sys_db/$pkg/manifest" ] || warn "No manifest found for $pkg, proceeding with database cleanup"
    log "Removing $pkg from system..."
    [ -f "/usr/src/lxpkg/repo/extra/$pkg/post-remove" ] && { log "Running post-remove script for $pkg"; sh -e "/usr/src/lxpkg/repo/extra/$pkg/post-remove" "$LXPKG_ROOT/" || warn "Post-remove script failed for $pkg"; }
    local removed=0
    if [ -f "$sys_db/$pkg/manifest" ]; then
        log "Processing manifest at $sys_db/$pkg/manifest"
        while read -r file; do
            case $file in
                */) continue ;;
                *)
                    local dest_file="$LXPKG_ROOT/$file"
                    if [ -f "$dest_file" ] || [ -L "$dest_file" ]; then
                        log "Removing $dest_file"
                        rm -f "$dest_file" || warn "Failed to remove $dest_file"
                        removed=$((removed + 1))
                    fi
                    ;;
            esac
        done < "$sys_db/$pkg/manifest"
    fi
    for bin_path in /usr/local/bin /usr/bin; do
        if [ -f "$bin_path/$pkg" ]; then
            log "Removing binary $bin_path/$pkg"
            rm -f "$bin_path/$pkg" || warn "Failed to remove $bin_path/$pkg"
            removed=$((removed + 1))
        fi
    done
    if [ -f "$sys_db/$pkg/manifest" ]; then
        while read -r file; do
            case $file in */) local dir="$LXPKG_ROOT/$file"; [ -d "$dir" ] && rmdir "$dir" 2>/dev/null || : ;; esac
        done < "$sys_db/$pkg/manifest"
    fi
    [ $removed -eq 0 ] && warn "No files removed for $pkg; cleaning up database entry"
    log "Removing $pkg from package database at $sys_db/$pkg"
    rm -rf "$sys_db/$pkg" || die "Failed to remove $sys_db/$pkg"
    log "Removed $pkg successfully"
}

# List installed packages
pkg_list() {
    set +f
    for pkg in "$sys_db/"*; do
        if [ -d "$pkg" ] && [ -f "$pkg/version" ]; then
            read -r ver rel < "$pkg/version" 2>/dev/null || continue
            printf '%b%s %b%s-%s%b\n' "$c_cyan" "${pkg##*/}" "$c_green" "$ver" "$rel" "$c_reset"
        fi
    done
    set -f
}

# Search packages
pkg_search() {
    set +f
    if [ $# -eq 0 ]; then
        IFS=:
        for path in $LXPKG_PATH; do
            [ -d "$path" ] || continue
            for section in "$path"/*; do
                [ -d "$section" ] || continue
                for pkg_path in "$section"/*; do
                    if [ -d "$pkg_path" ] && [ -f "$pkg_path/version" ]; then
                        pkg_name=$(basename "$pkg_path")
                        read -r ver rel < "$pkg_path/version" 2>/dev/null || continue
                        printf '%b * %b%-20s %bVersion:%b %-10s %bRepository:%b %s\n' "$c_grey" "$c_cyan" "$pkg_name" "$c_grey" "$c_green" "$ver-$rel" "$c_grey" "$c_purple" "$pkg_path"
                    fi
                done
            done
        done
        unset IFS
    else
        local found=0
        IFS=:
        for pkg in "$@"; do
            for path in $LXPKG_PATH; do
                [ -d "$path" ] || continue
                for section in "$path"/*; do
                    [ -d "$section" ] || continue
                    for pkg_path in "$section"/*; do
                        if [ -d "$pkg_path" ] && [ -f "$pkg_path/version" ]; then
                            pkg_name=$(basename "$pkg_path")
                            case "$pkg_name" in
                                *"$pkg"*)
                                    read -r ver rel < "$pkg_path/version" 2>/dev/null || continue
                                    printf '%b * %b%-20s %bVersion:%b %-10s %bRepository:%b %s\n' "$c_grey" "$c_cyan" "$pkg_name" "$c_grey" "$c_green" "$ver-$rel" "$c_grey" "$c_purple" "$pkg_path"
                                    found=1
                                ;;
                            esac
                        fi
                    done
                done
            done
        done
        unset IFS
        [ "$found" -eq 0 ] && log "No packages found matching '$*'"
    fi
    set -f
}

# Update repositories
pkg_update() {
    for repo in $LXPKG_PATH; do
        log "Updating repository $repo"
        [ -d "$repo/.git" ] && { git -C "$repo" pull; git -C "$repo" submodule update --remote --init -f; }
    done
    log "Run 'lxpkg U' to upgrade packages"
}

# Upgrade packages
pkg_upgrade() {
    log "Checking for new package versions"
    set +f
    local installed_found=0 packages=""
    for pkg in "$sys_db/"*; do
        [ -d "$pkg" ] || continue
        installed_found=1
        pkg_name=${pkg##*/}
        pkg_find_version "$pkg_name" "" "" "$sys_db"
        ver_pre=$repo_ver rel_pre=$repo_rel
        pkg_find_version "$pkg_name"
        [ "$ver_pre-$rel_pre" != "$repo_ver-$repo_rel" ] && {
            packages="$packages $pkg_name"
            printf '%b%s %b%s => %s%b\n' "$c_cyan" "$pkg_name" "$c_green" "$ver_pre-$rel_pre" "$repo_ver-$repo_rel" "$c_reset"
        }
    done
    set -f
    if [ "$installed_found" -eq 0 ]; then
        log "No installed packages found. Nothing to upgrade."
        return 0
    fi
    if [ -z "$packages" ]; then
        log "Nothing to do"
        return 0
    fi
    pkg_order $packages
    set -- $order
    prompt "Packages to update ($#): $*"
    for pkg; do
        pkg_resolve_deps "$pkg"
        pkg_build "$pkg"
        pkg_install "$pkg"
    done
    log "Updated all packages"
}

# Build and install multiple packages
pkg_build_all() {
    for pkg; do
        pkg_resolve_deps "$pkg"
        pkg_build "$pkg"
        pkg_install "$pkg"
    done
}

# List dependencies
pkg_depends_list() {
    pkg_find "$1"
    [ -f "$repo_dir/depends" ] && { log "Dependencies for $1:"; cat "$repo_dir/depends" | while read -r dep make; do [ "$make" = "make" ] || printf '%b - %b%s%b\n' "$c_grey" "$c_cyan" "$dep" "$c_reset"; done; } || log "$1 has no explicit dependencies"
}

# Show manifest
pkg_manifest() {
    pkg_find "$1" "" -f "$sys_db"
    log "Files installed by $1:"
    while read -r file; do
        printf '%b - %b%s%b\n' "$c_grey" "$c_purple" "$LXPKG_ROOT/$file" "$c_reset"
    done < "$sys_db/$1/manifest"
}

# Show ownership
pkg_owns() {
    [ -n "$1" ] || die "Usage: lxpkg o /path/to/file"
    local file="$1"
    case $file in
        /*) cd -P "${LXPKG_ROOT:-/}${file%/*}" || die "Cannot access directory for $file"; [ "$PWD" = / ] && LXPKG_ROOT= ;;
        */*) cd -P "${file%/*}" || die "Cannot access directory for $file" ;;
        *) cd -P . || die "Cannot access current directory" ;;
    esac
    local search_path="${PWD#"$LXPKG_ROOT"}/${file##*/}"
    [ -f "$PWD/${file##*/}" ] || die "File $file does not exist"
    set +f
    local owner=""
    for manifest in "$sys_db"/*/manifest; do
        [ -f "$manifest" ] || continue
        grep -qFx "$search_path" "$manifest" && { owner=$(basename "$(dirname "$manifest")"); break; }
    done
    set -f
    [ -n "$owner" ] && log "File $file is owned by $owner" || log "File $file is not owned by any package"
}

# List orphans
pkg_orphans() {
    log "Checking for orphaned packages..."
    set +f
    local core_pkgs="lxpkg gcc musl" orphans=""
    for pkg in "$sys_db/"*; do
        [ -d "$pkg" ] || continue
        pkg_name=${pkg##*/}
        contains "$core_pkgs" "$pkg_name" && continue
        local is_dep=0
        for other_pkg in "$sys_db/"*; do
            [ -d "$other_pkg" ] || continue
            [ "${other_pkg##*/}" = "$pkg_name" ] && continue
            [ -f "$other_pkg/depends" ] && grep -q "^$pkg_name$" "$other_pkg/depends" && { is_dep=1; break; }
        done
        [ "$is_dep" -eq 0 ] && orphans="$orphans $pkg_name"
    done
    set -f
    [ -z "$orphans" ] && log "No orphaned packages found" || for pkg in $orphans; do printf '%b * %b%s%b\n' "$c_grey" "$c_cyan" "$pkg" "$c_reset"; done
}

# List reverse dependencies (installed)
pkg_revdepends() {
    pkg_find "$1" "" -f "$sys_db"
    log "Checking for packages that depend on $1..."
    set +f
    local found=0
    for other_pkg in "$sys_db/"*; do
        [ -d "$other_pkg" ] || continue
        other_pkg_name=${other_pkg##*/}
        [ "$other_pkg_name" = "$1" ] && continue
        [ -f "$other_pkg/depends" ] && grep -q "^$1$" "$other_pkg/depends" && { printf '%b * %b%s%b\n' "$c_grey" "$c_cyan" "$other_pkg_name" "$c_reset"; found=1; }
    done
    set -f
    [ "$found" -eq 0 ] && log "No installed packages depend on $1"
}

# List reverse dependencies (repository)
pkg_reporevdepends() {
    [ -n "$1" ] || die "Usage: lxpkg rr pkg"
    local pkg="$1"
    log "Checking for repository packages that depend on $pkg..."
    set +f
    local found=0
    for repo_path in $LXPKG_PATH; do
        for depends in "$repo_path"/*/depends; do
            [ -f "$depends" ] || continue
            repo_pkg=$(basename "$(dirname "$depends")")
            grep -q "^$pkg$" "$depends" && { printf '%b * %b%s%b (in %s)\n' "$c_grey" "$c_cyan" "$repo_pkg" "$c_reset" "$repo_path"; found=1; }
        done
    done
    set -f
    [ "$found" -eq 0 ] && log "No repository packages depend on $pkg"
}

# Calculate package size
pkg_size() {
    pkg_find "$1" "" -f "$sys_db"
    log "Calculating size of $1..."
    local total_size=0
    while read -r file; do
        case $file in */) continue ;; esac
        local size=$(du -sk "$LXPKG_ROOT/$file" 2>/dev/null | awk '{print $1}' || echo 0)
        total_size=$((total_size + size))
        case ${#size} in
            [0-3]) hum="$size KB" ;;
            [4-6]) hum="$((size / 1024)) MB" ;;
            [7-9]) hum="$((size / 1024 / 1024)) GB" ;;
            *) hum="$size B" ;;
        esac
        printf '%b - %b%-10s %b%s%b\n' "$c_grey" "$c_green" "$hum" "$c_purple" "$LXPKG_ROOT/$file" "$c_reset"
    done < "$sys_db/$1/manifest"
    case ${#total_size} in
        [0-3]) hum="$total_size KB" ;;
        [4-6]) hum="$((total_size / 1024)) MB" ;;
        [7-9]) hum="$((size / 1024 / 1024)) GB" ;;
        *) hum="$total_size B" ;;
    esac
    log "Total size for $1: $hum"
}

# Clean cache
pkg_clean_cache() {
    log "Cleaning package cache..."
    set +f
    for cache in "$cache_dir"/*.tar.*; do
        [ -f "$cache" ] || continue
        rm -f "$cache"
        log "Removed $cache"
    done
    set -f
    log "Cache cleaned."
}

# Create temporary directories
create_tmp_dirs() {
    cache_dir=${LXPKG_CACHEDIR:-/var/cache/lxpkg}
    src_dir=/tmp/lxpkg-$LOGNAME-$RANDOM/src
    bld_dir=/tmp/lxpkg-$LOGNAME-$RANDOM/build
    pkg_dir=/tmp/lxpkg-$LOGNAME-$RANDOM/pkg
    mkdir -p "$cache_dir" "$src_dir" "$bld_dir" "$pkg_dir"
    sys_db=${LXPKG_ROOT:-/}var/db/lxpkg/installed
    sys_ch=$LXPKG_ROOT/${cho_db:=var/db/lxpkg/choices}
    pkg_db=var/db/lxpkg/installed
}

# Set up trap
trap_on() { trap 'rm -rf "$src_dir" "$pkg_dir" "$bld_dir"; exit' INT TERM EXIT; }

# Parse arguments
args() {
    sys_db=${LXPKG_ROOT:-/}var/db/lxpkg/installed
    case $1 in
        a|alternatives) shift; pkg_alternatives "$@";;
        b|build) shift; for pkg; do pkg_build "$pkg"; done ;;
        c|checksum) shift; for pkg; do pkg_checksums "$pkg"; done ;;
        clean) shift; pkg_clean_cache ;;
        d|depends) shift; for pkg; do pkg_depends_list "$pkg"; done ;;
        i|install) shift; for pkg; do pkg_install "$pkg"; done ;;
        m|manifest) shift; for pkg; do pkg_manifest "$pkg"; done ;;
        o|owns) shift; for file; do pkg_owns "$file"; done ;;
        O|orphans) shift; pkg_orphans ;;
        r|remove) shift; for pkg; do pkg_remove "$pkg"; done ;;
        R|revdepends) shift; for pkg; do pkg_revdepends "$pkg"; done ;;
        rr|reporevdepends) shift; for pkg; do pkg_reporevdepends "$pkg"; done ;;
        s|search) shift; pkg_search "$@";;
        S|size) shift; for pkg; do pkg_size "$pkg"; done ;;
        l|list) shift; pkg_list ;;
        u|update) shift; pkg_update ;;
        U|upgrade) shift; pkg_upgrade ;;
        v|version) log "lxpkg version 1.2.4" ;;
        h|help)
            printf '%b%s%b\n' "$c_green" "lxpkg: Package manager for lxos" "$c_reset"
            printf '%b%s%b\n' "$c_grey" "Usage: lxpkg [command] [pkg...]" "$c_reset"
            printf '%b%s%b\n' "$c_green" "Commands:" "$c_reset"
            for cmd in \
                "a,alternatives:List or swap package alternatives" \
                "b,build:Build packages from source" \
                "c,checksum:Generate package checksums" \
                "clean:Clean package cache" \
                "d,depends:List package dependencies" \
                "i,install:Install packages" \
                "m,manifest:Show installed package files" \
                "o,owns:Show which package owns a file" \
                "O,orphans:List orphaned packages" \
                "r,remove:Remove packages" \
                "R,revdepends:List installed reverse dependencies" \
                "rr,reporevdepends:List repository reverse dependencies" \
                "s,search:Search for packages" \
                "S,size:Show package size" \
                "l,list:List installed packages" \
                "u,update:Update repositories" \
                "U,upgrade:Upgrade installed packages" \
                "v,version:Show lxpkg version" \
                "h,help:Show this help message"; do
                printf '  %b%-20s%b %s\n' "$c_cyan" "${cmd%%:*}" "$c_reset" "${cmd#*:}"
            done
            printf '%b%s%b\n' "$c_green" "Environment Variables:" "$c_reset"
            for var in \
                "BOOTSTRAP_LXPKG:Install to a custom root (e.g., /mnt)" \
                "LXPKG_PATH:Repository paths (default: /usr/src/lxpkg/repo)" \
                "LXPKG_COMPRESS:Compression type (gz, xz, zst; default: xz)" \
                "LXPKG_SKIP_CHECKSUMS:Skip checksum verification (set to 1)" \
                "LXPKG_STRIP:Disable binary stripping (set to 0)"; do
                printf '  %b%-20s%b %s\n' "$c_cyan" "${var%%:*}" "$c_reset" "${var#*:}"
            done
            exit 0
            ;;
        *) printf '%b%s%b\n' "$c_grey" "lxpkg h for help" "$c_reset"; exit 1 ;;
    esac
}

# Main function
main() {
    create_default_conf
    [ -f "/etc/lxpkg.conf" ] && . /etc/lxpkg.conf
    : "${LXPKG_PATH:=/usr/src/lxpkg/repo}"
    : "${LXPKG_COMPRESS:=xz}"
    [ "$LXPKG_COLOR" = 0 ] || [ ! -t 2 ] || {
        c_reset='\033[m'
        c_grey='\033[3;90m'
        c_green='\033[1;32m'
        c_cyan='\033[1;36m'
        c_purple='\033[3;35m'
        c_yellow='\033[1;33m'
        c_red='\033[1;31m'
        c_blue='\033[1;34m'
    }
    ppwd=$PWD
    cmd_su=${LXPKG_SU:-"$(command -v lx || command -v sudo || command -v doas || command -v su)"} || cmd_su=su
    cmd_get=${LXPKG_GET:-"$(command -v aria2c || command -v axel || command -v curl || command -v wget)"} || die "No download utility found"
    create_tmp_dirs
    trap_on
    [ "$(id -u)" -eq 0 ] || [ -n "$BOOTSTRAP_LXPKG" ] || [ -n "$LXPKG_SUDO" ] || exec $cmd_su "$0" "$@"
    args "$@"
}

main "$@"
