#!/bin/sh
# lxpkg: package manager for lxos (https://learnixos.github.io)
# Version: 1.2.7

# Exit on errors
set -e

# ANSI color codes
c_reset='\033[m'         # Reset
c_grey='\033[3;90m'      # Italic grey (steps)
c_green='\033[1;32m'     # Bold green (success)
c_cyan='\033[1;36m'      # Bold cyan (package names)
c_purple='\033[3;35m'    # Purple (paths)
c_yellow='\033[1;33m'    # Bold yellow (warnings)
c_red='\033[1;31m'       # Bold red (errors)
c_blue='\033[1;34m'      # Bold blue (installation)

# Logging functions
log() {
    [ "${LXPKG_VERBOSE:-0}" -eq 1 ] || return 0
    printf '%b%s %b%s%b\n' "$c_grey" "==>" "$c_green" "$*" "$c_reset"
}
warn() { printf '%b%s %b%s%b\n' "$c_yellow" "WARNING:" "$c_reset" "$*" "$c_reset" >&2; }
die() { printf '%b%s %b%s%b\n' "$c_red" "ERROR:" "$c_reset" "$*" "$c_reset" >&2; exit 1; }

# Utility functions
ok() { [ -e "$1" ] || return 1; }
equ() { [ "$1" = "$2" ]; }
contains() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }
prompt() {
    printf '%b%s%b\n' "$c_green" "$*" "$c_reset"
    printf '%b%s%b' "$c_grey" "Continue? [y/N] " "$c_reset"
    read -r response
    case "$response" in
        [yY]*) return 0 ;;
        *) die "Operation aborted by user" ;;
    esac
}

# Create default /etc/lxpkg.conf
create_default_conf() {
    local conf_file="/etc/lxpkg.conf"
    if [ ! -f "$conf_file" ]; then
        log "Creating default configuration file at $conf_file"
        printf '# lxpkg configuration file\n' > "$conf_file"
        printf 'LXPKG_PATH=/usr/src/lxpkg/repo\n' >> "$conf_file"
        printf 'LXPKG_COMPRESS=xz\n' >> "$conf_file"
        printf 'LXPKG_SKIP_CHECKSUMS=0\n' >> "$conf_file"
        printf 'LXPKG_STRIP=1\n' >> "$conf_file"
        printf 'LXPKG_COLOR=1\n' >> "$conf_file"
        printf 'LXPKG_VERBOSE=0\n' >> "$conf_file"
    fi
}

# Check for pre-installed system packages
pkg_check_system() {
    local pkg="$1"
    local paths="/bin /usr/bin /sbin /usr/sbin /usr/local/bin /usr/local/sbin /lib /usr/lib /lib64 /usr/lib64 /opt"
    
    case "$pkg" in
        bash)
            for path in /bin/bash /usr/bin/bash; do
                [ -x "$path" ] && { log "$pkg detected at $path, skipping"; return 0; }
            done
            ;;
        glibc)
            for lib in /lib/libc.so* /usr/lib/libc.so* /lib64/libc.so* /usr/lib64/libc.so*; do
                [ -f "$lib" ] && { log "$pkg detected in $lib, skipping"; return 0; }
            done
            ;;
        xorg-server)
            [ -f "/usr/bin/Xorg" ] || [ -f "/usr/lib/xorg/Xorg" ] && { log "$pkg detected, skipping"; return 0; }
            ;;
        libreoffice)
            [ -d "/opt/libreoffice" ] || [ -f "/usr/bin/libreoffice" ] && { log "$pkg detected in /opt or /usr/bin, skipping"; return 0; }
            ;;
        sed|grep|procps-ng)
            for path in /bin /usr/bin; do
                [ -x "$path/$pkg" ] && { log "$pkg detected at $path/$pkg, marking as system-installed"; mkdir -p "$sys_db/$pkg"; printf 'system system\n' > "$sys_db/$pkg/version"; return 0; }
            done
            ;;
        *)
            if [ -d "$sys_db/$pkg" ] && [ -f "$sys_db/$pkg/version" ]; then
                read -r ver rel < "$sys_db/$pkg/version" 2>/dev/null
                log "$pkg version $ver-$rel already installed, skipping"
                return 0
            fi
            for path in $paths; do
                if [ -f "$path/$pkg" ] || [ -f "$path/lib$pkg.so" ] || [ -d "$path/$pkg" ]; then
                    log "$pkg detected in $path, marking as system-installed"
                    mkdir -p "$sys_db/$pkg"
                    printf 'system system\n' > "$sys_db/$pkg/version"
                    return 0
                fi
            done
            ;;
    esac
    return 1
}

# Find package
pkg_find() {
    _pkg_find "$@" || return 1
}

_pkg_find() {
    local pkg="$1" find_type="${2:-}" test_type="${3:-}" search_path="${4:-$LXPKG_PATH}"
    IFS=:
    set +f
    local found=0
    for path in $search_path "${test_type:-$sys_db}"; do
        [ -d "$path" ] || continue
        for section in "$path"/*; do
            [ -d "$section" ] || continue
            for pkg_path in "$section"/*; do
                if [ -d "$pkg_path" ] && [ -f "$pkg_path/version" ] && [ "$(basename "$pkg_path")" = "$pkg" ]; then
                    found=1
                    repo_dir="$pkg_path"
                    repo_name="$pkg"
                    test "${test_type:--d}" "$pkg_path" && set -- "$@" "$pkg_path"
                fi
            done
        done
    done
    unset IFS
    set -f
    case $find_type-$# in
        *-4) return 1 ;;
        -*) : ;;
        *) shift 4; printf '%s\n' "$@"
    esac
    [ "$found" -eq 1 ] || return 1
}

# Find package version
pkg_find_version() {
    read -r ver_pre rel_pre < "$repo_dir/version" 2>/dev/null || { ver_pre=; rel_pre=; }
    repo_ver=$ver_pre
    repo_rel=${rel_pre:-0}
}

# Check package cache
pkg_cache() {
    pkg_find_version "$1"
    local cache_file="$cache_dir/$1@$repo_ver-$repo_rel.tar.$LXPKG_COMPRESS"
    if [ -f "$cache_file" ]; then
        log "Found cached package $1@$repo_ver-$repo_rel"
        mkdir -p "$pkg_dir/$1"
        tar -C "$pkg_dir/$1" -xvf "$cache_file" >/dev/null
        return 0
    fi
    return 1
}



# Update repositories
pkg_update() {
    log "Updating package repositories..."
    IFS=:
    for repo in $LXPKG_PATH; do
        [ -d "$repo" ] || { warn "Repository path $repo does not exist"; continue; }
        local repo_url="https://github.com/LearnixOS/repo/archive/refs/heads/main.tar.gz"
        local repo_name="LearnixOS-repo"
        log "Updating repository $repo_name from $repo_url"
        local tmp_dir=$(mktemp -d)
        if curl -L "$repo_url" -o "$tmp_dir/repo.tar.gz" 2>/dev/null; then
            mkdir -p "$tmp_dir/repo"
            tar -C "$tmp_dir/repo" -xzf "$tmp_dir/repo.tar.gz" --strip-components=1 || { warn "Failed to extract $repo_url"; rm -rf "$tmp_dir"; continue; }
            rm -rf "$repo" || warn "Failed to remove old repository $repo"
            mv "$tmp_dir/repo" "$repo" || warn "Failed to update repository $repo"
            log "Repository $repo_name updated successfully"
        else
            warn "Failed to download $repo_url for $repo_name"
        fi
        rm -rf "$tmp_dir"
    done
    unset IFS
    log "Repository update completed"
}


# Check checksums (for logging only)
pkg_checksums() {
    pkg_find "$1"
    if [ -f "$repo_dir/checksums" ]; then
        local checksum_lines=$(wc -l < "$repo_dir/checksums" 2>/dev/null || echo 0)
        if [ "$checksum_lines" -gt 0 ]; then
            log "Found checksum file at $repo_dir/checksums with $checksum_lines entries for $1"
            return 0
        else
            warn "Checksum file $repo_dir/checksums is empty for $1"
            return 1
        fi
    else
        warn "No checksums file found at $repo_dir/checksums for $1"
        return 1
    fi
}

# Verify checksums
pkg_verify() {
    local pkg="$1"
    pkg_find "$pkg"
    if [ "$LXPKG_SKIP_CHECKSUMS" = "1" ]; then
        log "Checksum verification skipped for $pkg (LXPKG_SKIP_CHECKSUMS=1)"
        return 0
    fi
    if [ ! -f "$repo_dir/checksums" ]; then
        warn "No checksums file found at $repo_dir/checksums for $pkg"
        prompt "Checksum file missing for $pkg. Continue without verification?"
        return 0
    fi
    local checksum_lines=$(wc -l < "$repo_dir/checksums" 2>/dev/null || echo 0)
    if [ "$checksum_lines" -eq 0 ]; then
        warn "Checksum file $repo_dir/checksums is empty for $pkg"
        prompt "Empty checksum file for $pkg. Continue without verification?"
        return 0
    fi
    log "Verifying checksums for $pkg"
    local src_dir="$src_dir/$pkg"
    while read -r expected_checksum file; do
        [ -z "$file" ] && continue
        local full_path="$src_dir/$file"
        if [ ! -f "$full_path" ]; then
            warn "Source file $full_path not found for $pkg"
            prompt "Missing source file $file for $pkg. Continue?"
            continue
        fi
        local actual_checksum=$(sha256sum "$full_path" | awk '{print $1}')
        if [ "$actual_checksum" != "$expected_checksum" ]; then
            warn "Checksum mismatch for $file in $pkg: expected $expected_checksum, got $actual_checksum"
            prompt "Checksum verification failed for $file in $pkg. Continue?"
            continue
        fi
        log "Checksum verified for $file in $pkg"
    done < "$repo_dir/checksums"
    log "All checksums verified for $pkg"
    return 0
}

# Search for packages
pkg_search() {
    local search_term="${1:-.}"
    log "Searching for packages matching '$search_term'..."
    set +f
    local found=0
    IFS=:
    for path in $LXPKG_PATH; do
        [ -d "$path" ] || continue
        for section in "$path"/*; do
            [ -d "$section" ] || continue
            for pkg_path in "$section"/*; do
                if [ -d "$pkg_path" ] && [ -f "$pkg_path/version" ]; then
                    local pkg_name=$(basename "$pkg_path")
                    if printf '%s' "$pkg_name" | grep -qi "$search_term"; then
                        found=1
                        read -r ver rel < "$pkg_path/version" 2>/dev/null || { ver="unknown"; rel="unknown"; }
                        local section_name=$(basename "$section")
                        printf '%b * %b%-20s %bSection:%b %s %bVersion:%b %s-%s\n' \
                            "$c_grey" "$c_cyan" "$pkg_name" "$c_grey" "$c_green" "$section_name" "$c_grey" "$c_green" "$ver" "$rel"
                    fi
                fi
            done
        done
    done
    unset IFS
    set -f
    [ "$found" -eq 0 ] && warn "No packages found matching '$search_term'"
    return 0
}

# Helper function to locate Cargo.toml
find_cargo_toml() {
    local dir="$1"
    local cargo_toml=$(find "$dir" -maxdepth 2 -type f -name "Cargo.toml" | head -n 1)
    if [ -n "$cargo_toml" ]; then
        dirname "$cargo_toml"
        return 0
    else
        warn "No Cargo.toml found in $dir or its subdirectories"
        return 1
    fi
}


# Remove package
pkg_remove() {
    local pkg="$1" sys_db="/var/db/lxpkg/installed"
    [ -d "$sys_db/$pkg" ] || die "Package '$pkg' not found in system"
    [ -f "$sys_db/$pkg/manifest" ] || warn "No manifest found for $pkg, proceeding with database cleanup"
    log "Removing $pkg from system..."
    [ -f "/usr/src/lxpkg/repo/extra/$pkg/post-remove" ] && { log "Running post-remove script for $pkg"; sh -e "/usr/src/lxpkg/repo/extra/$pkg/post-remove" "$LXPKG_ROOT/" || warn "Post-remove script failed for $pkg"; }
    local removed=0
    if [ -f "$sys_db/$pkg/manifest" ]; then
        log "Processing manifest at $sys_db/$pkg/manifest"
        while read -r file; do
            case $file in
                */) continue ;;
                *)
                    local dest_file="$LXPKG_ROOT/$file"
                    if [ -f "$dest_file" ] || [ -L "$dest_file" ]; then
                        log "Removing $dest_file"
                        rm -f "$dest_file" || warn "Failed to remove $dest_file"
                        removed=$((removed + 1))
                    fi
                    ;;
            esac
        done < "$sys_db/$pkg/manifest"
    fi
    for bin_path in /usr/local/bin /usr/bin; do
        if [ -f "$bin_path/$pkg" ]; then
            log "Removing binary $bin_path/$pkg"
            rm -f "$bin_path/$pkg" || warn "Failed to remove $bin_path/$pkg"
            removed=$((removed + 1))
        fi
    done
    if [ -f "$sys_db/$pkg/manifest" ]; then
        while read -r file; do
            case $file in */) local dir="$LXPKG_ROOT/$file"; [ -d "$dir" ] && rmdir "$dir" 2>/dev/null || : ;; esac
        done < "$sys_db/$pkg/manifest"
    fi
    [ $removed -eq 0 ] && warn "No files removed for $pkg; cleaning up database entry"
    log "Removing $pkg from package database at $sys_db/$pkg"
    rm -rf "$sys_db/$pkg" || die "Failed to remove $sys_db/$pkg"
    log "Removed $pkg successfully"
}


# Get sources
pkg_sources() {
    pkg_find "$1"
    [ -f "$repo_dir/sources" ] && cat "$repo_dir/sources" || { warn "No sources file found for $1"; return 1; }
}

# Get dependencies
pkg_depends() {
    pkg_find "$1"
    [ -f "$repo_dir/depends" ] && cat "$repo_dir/depends" | while read -r dep make; do [ "$make" = "make" ] || printf '%s\n' "$dep"; done
}

# Check if installed
pkg_is_installed() { [ -d "$sys_db/$1" ]; }

# Clean cache
pkg_clean_cache() {
    log "Cleaning package cache..."
    set +f
    for cache in "$cache_dir"/*.tar.*; do
        [ -f "$cache" ] || continue
        rm -f "$cache"
        log "Removed $cache"
    done
    set -f
    log "Cache cleaned."
}


# Resolve dependencies
pkg_resolve_deps() {
    unset _seen_deps _dep_stack
    log "Resolving dependencies for $@..."
    _resolve_deps "$@" || die "Failed to resolve dependencies for $@"
}

_resolve_deps() {
    for pkg in "$@"; do
        contains "$_seen_deps" "$pkg" && continue
        contains "$_dep_stack" "$pkg" && { warn "Circular dependency detected involving $pkg"; continue; }
        _dep_stack="$_dep_stack $pkg"
        if ! pkg_find "$pkg" "" "" "$LXPKG_PATH"; then
            warn "Dependency $pkg not found in repositories"
            prompt "Dependency $pkg is missing. Continue with installation?"
            continue
        fi
        if [ -f "$repo_dir/depends" ]; then
            local deps=$(pkg_depends "$pkg")
            if [ -n "$deps" ]; then
                log "Dependencies for $c_cyan$pkg$c_reset:"
                for dep in $deps; do
                    if pkg_is_installed "$dep"; then
                        read -r ver rel < "$sys_db/$dep/version" 2>/dev/null || { ver="unknown"; rel="unknown"; }
                        printf '%b * %b%-20s %bStatus:%b %s %bVersion:%b %s-%s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_green" "Installed" "$c_grey" "$c_green" "$ver" "$rel"
                    elif pkg_check_system "$dep"; then
                        printf '%b * %b%-20s %bStatus:%b %s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_green" "System-installed"
                    elif ! pkg_find "$dep" "" "" "$LXPKG_PATH"; then
                        printf '%b * %b%-20s %bStatus:%b %s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_red" "Missing"
                    else
                        printf '%b * %b%-20s %bStatus:%b %s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_yellow" "Not installed"
                    fi
                done
            else
                log "$pkg has no dependencies"
            fi
            for dep in $deps; do
                if ! pkg_is_installed "$dep" && ! pkg_check_system "$dep"; then
                    if ! pkg_find "$dep" "" "" "$LXPKG_PATH"; then
                        warn "Dependency $dep not found in repositories"
                        prompt "Dependency $dep is missing. Continue with installation?"
                        continue
                    fi
                    log "Installing missing dependency: $dep"
                    _resolve_deps "$dep"
                    pkg_build "$dep"
                    pkg_install "$dep"
                fi
            done
        fi
        _seen_deps="$_seen_deps $pkg"
        _dep_stack=${_dep_stack% $pkg}
    done
}

# List installed packages
pkg_list() {
    set +f
    for pkg in "$sys_db/"*; do
        if [ -d "$pkg" ] && [ -f "$pkg/version" ]; then
            read -r ver rel < "$pkg/version" 2>/dev/null || continue
            printf '%b%s %b%s-%s%b\n' "$c_cyan" "${pkg##*/}" "$c_green" "$ver" "$rel" "$c_reset"
        fi
    done
    set -f
}





# Fix runtime dependencies
pkg_fix_deps() {
    local pkg="$1"
    [ -f "$repo_dir/depends" ] || { log "$pkg has no dependencies"; return 0; }
    local deps=$(cat "$repo_dir/depends" | while read -r dep make; do [ "$make" = "make" ] || printf '%s\n' "$dep"; done)
    if [ -n "$deps" ]; then
        log "Dependencies for $c_cyan$pkg$c_reset:"
        for dep in $deps; do
            case $dep in *'|'*) for alt_dep in $dep; do case $alt_dep in *'|'*) continue ;; *) dep=$alt_dep; break ;; esac; done ;; esac
            if pkg_is_installed "$dep"; then
                read -r ver rel < "$sys_db/$dep/version" 2>/dev/null || { ver="unknown"; rel="unknown"; }
                printf '%b * %b%-20s %bStatus:%b %s %bVersion:%b %s-%s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_green" "Installed" "$c_grey" "$c_green" "$ver" "$rel"
            elif pkg_check_system "$dep"; then
                printf '%b * %b%-20s %bStatus:%b %s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_green" "System-installed"
            elif ! pkg_find "$dep" "" "" "$LXPKG_PATH"; then
                printf '%b * %b%-20s %bStatus:%b %s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_red" "Missing"
                prompt "Dependency $dep not found in repositories. Continue with installation?"
            else
                printf '%b * %b%-20s %bStatus:%b %s\n' "$c_grey" "$c_cyan" "$dep" "$c_grey" "$c_yellow" "Not installed"
                log "Installing dependency $dep for $pkg"
                pkg_install "$dep"
            fi
        done
    else
        log "$pkg has no dependencies"
    fi
}

# Download and extract sources
pkg_source() {
    pkg_find "$1"
    mkdir -p "$src_dir/$1" || die "Failed to create source directory $src_dir/$1"
    cd "$src_dir/$1" || die "Failed to change to source directory $src_dir/$1"
    if [ ! -f "$repo_dir/sources" ]; then
        warn "No sources file found at $repo_dir/sources for $1"
        return 1
    fi
    local i=1 has_sources=0
    while read -r url file; do
        [ -z "$url" ] && continue
        has_sources=1
        file=${file:-$(basename "$url")}
        log "Processing source #$i: $url"
        if [ ! -f "$file" ]; then
            log "Downloading $1: $url to $file..."
            if ! curl -L "$url" -o "$file" 2>/dev/null; then
                warn "Failed to download $url for $1"
                return 1
            fi
            log "Downloaded $1: $file successfully"
        fi
        case $file in
            *.tar.gz|*.tgz)
                log "Extracting $file to $src_dir/$1"
                if ! tar -xzf "$file" -C "$src_dir/$1"; then
                    warn "Failed to extract $file for $1"
                    return 1
                fi
                ;;
            *.tar.bz2|*.tbz2)
                log "Extracting $file to $src_dir/$1"
                if ! tar -xjf "$file" -C "$src_dir/$1"; then
                    warn "Failed to extract $file for $1"
                    return 1
                fi
                ;;
            *.tar.xz|*.txz)
                log "Extracting $file to $src_dir/$1"
                if ! tar -xJf "$file" -C "$src_dir/$1"; then
                    warn "Failed to extract $file for $1"
                    return 1
                fi
                ;;
            *.zip)
                log "Extracting $file to $src_dir/$1"
                if ! unzip -q "$file" -d "$src_dir/$1"; then
                    warn "Failed to extract $file for $1"
                    return 1
                fi
                ;;
            *)
                warn "Unknown archive type for $file, skipping extraction"
                continue
                ;;
        esac
        i=$((i + 1))
    done < "$repo_dir/sources"
    if [ "$has_sources" -eq 0 ]; then
        warn "No valid source URLs found in $repo_dir/sources for $1"
        return 1
    fi
    if ! find "$src_dir/$1" -maxdepth 1 -type f | grep -q .; then
        warn "Source directory $src_dir/$1 is empty or contains no files for $1"
        return 1
    fi
    log "Source files prepared for $1 in $src_dir/$1"
    return 0
}

# Detect build system
detect_build_system() {
    [ -f "Cargo.toml" ] && echo "cargo" && return
    [ -f "setup.py" ] || [ -f "requirements.txt" ] && echo "python" && return
    [ -f "meson.build" ] && echo "meson" && return
    [ -f "CMakeLists.txt" ] && echo "cmake" && return
    [ -f "autogen.sh" ] && echo "autotools-autogen" && return
    [ -f "configure" ] && echo "autotools" && return
    [ -f "Makefile" ] || [ -f "makefile" ] && echo "make" && return
    echo "unknown"
}

# Build package
pkg_build() {
    pkg_find "$1" || die "Package '$1' not found"
    pkg_verify "$1"
    mkdir -p "$bld_dir/$1" || die "Failed to create build directory $bld_dir/$1"
    cd "$bld_dir/$1" || die "Failed to change to build directory $bld_dir/$1"
    
    log "Copying source files for $1 to $bld_dir/$1"
    cp -r "$src_dir/$1"/* "$bld_dir/$1" 2>/dev/null || cp -r "$src_dir/$1"/.[!.]* "$bld_dir/$1" 2>/dev/null || die "Failed to copy source files for $1"
    
    local build_dir="$bld_dir/$1"
    if [ -f "Cargo.toml" ]; then
        build_dir=$(find_cargo_toml "$bld_dir/$1") || build_dir="$bld_dir/$1"
    fi
    cd "$build_dir" || die "Failed to change to build directory $build_dir"
    
    log "Building $1 in $build_dir..."
    local build_system=$(detect_build_system)
    log "Detected build system: $build_system for $1 in $PWD"
    case "$build_system" in
        cargo)
            log "Building Rust project $1 with Cargo"
            cargo build --release || die "Cargo build failed for $1"
            mkdir -p "$pkg_dir/$1/usr/bin"
            find target/release -maxdepth 1 -type f -executable -exec cp -f {} "$pkg_dir/$1/usr/bin/" \; || warn "Failed to copy binaries for $1"
            ;;
        python)
            log "Installing Python-based project $1"
            [ -f "setup.py" ] && {
                python3 setup.py install --prefix=/usr --root="$pkg_dir/$1" || die "Python setup.py install failed for $1"
            } || {
                [ -f "requirements.txt" ] && {
                    pip3 install -r requirements.txt --target="$pkg_dir/$1/usr/lib/python3/dist-packages" || warn "Failed to install Python dependencies for $1"
                }
                find . -maxdepth 1 -type f -executable -exec cp -f {} "$pkg_dir/$1/usr/bin/" \; || warn "Failed to copy Python scripts for $1"
            }
            ;;
        meson)
            meson setup build --prefix=/usr
            ninja -C build -j"$(nproc 2>/dev/null || echo 4)"
            ninja -C build install DESTDIR="$pkg_dir/$1"
            ;;
        cmake)
            mkdir -p build
            cd build
            cmake .. -DCMAKE_INSTALL_PREFIX=/usr
            make -j"$(nproc 2>/dev/null || echo 4)"
            make install DESTDIR="$pkg_dir/$1"
            cd ..
            ;;
        autotools-autogen)
            ./autogen.sh
            ./configure --prefix=/usr
            make -j"$(nproc 2>/dev/null || echo 4)"
            make install DESTDIR="$pkg_dir/$1"
            ;;
        autotools)
            ./configure --prefix=/usr
            make -j"$(nproc 2>/dev/null || echo 4)"
            make install DESTDIR="$pkg_dir/$1"
            ;;
        make)
            make -j"$(nproc 2>/dev/null || echo 4)"
            make install DESTDIR="$pkg_dir/$1"
            ;;
        *)
            [ -f "$repo_dir/build" ] && {
                log "Running custom build script for $1"
                sh -e "$repo_dir/build" "$pkg_dir/$1" || die "Custom build script failed for $1"
            } || die "Unsupported build system for $1: $build_system"
            ;;
    esac
    log "Build completed for $1"
}

# Generate etcsums
pkg_etcsums() {
    local sums=$(mktemp)
    find "$pkg_dir/$1/etc" -type f 2>/dev/null | while read -r file; do
        file=${file#"$pkg_dir/$1/"}
        [ -f "$LXPKG_ROOT/$file" ] && sha256sum "$LXPKG_ROOT/$file" | sed "s|$LXPKG_ROOT/||" >> "$sums"
    done
    [ -s "$sums" ] && mv "$sums" "$pkg_dir/$1/$pkg_db/$1/etcsums" || rm -f "$sums"
}

# Handle /etc files
pkg_etc() {
    local pkg="$1" file="$2"
    [ -f "$sys_db/$pkg/etcsums" ] && grep -Fx "$file" "$sys_db/$pkg/etcsums" >/dev/null && return 0
    [ -f "$LXPKG_ROOT/$file" ] && { mv "$LXPKG_ROOT/$file" "$LXPKG_ROOT/$file.lxpkgnew"; return 0; }
    return 1
}

# Strip binaries
pkg_strip() {
    log "$1: Stripping binaries and libraries"
    [ "${LXPKG_STRIP:-1}" = "0" ] && return
    find "$pkg_dir/$1" \( -path '*/bin/*' -o -path '*/lib/*' \) -type f -exec strip --strip-unneeded {} \; 2>/dev/null || :
}

# Check conflicts
pkg_conflicts() {
    log "$1: Checking for package conflicts"
    while read -r file; do
        case $file in */ | var/db/lxpkg/installed/*) continue ;; esac
        if [ -e "$LXPKG_ROOT/$file" ] && [ ! -d "$LXPKG_ROOT/$file" ]; then
            for pkg in "$sys_db/"*; do
                [ -f "$pkg/manifest" ] || continue
                grep -Fx "$file" "$pkg/manifest" >/dev/null && die "File $file from $1 conflicts with ${pkg##*/}"
            done
        fi
    done < "$pkg_dir/$1/$pkg_db/$1/manifest"
}

# Manage alternatives
pkg_alternatives() {
    if [ "$1" = "-" ]; then
        while read -r pkg path; do pkg_swap "$pkg" "$path"; done
    elif [ -n "$1" ]; then
        pkg_swap "$@"
    else
        set +f
        for alt in "$sys_ch/"*; do
            [ -e "$alt" ] || continue
            alt_name=$(basename "$alt")
            pkg=${alt_name%%>*}
            path=${alt_name#*>}
            path=${path//>/\/}
            printf '%s %s\n' "$pkg" "/$path"
        done
        set -f
    fi
}

# Swap alternatives
pkg_swap() {
    [ -d "$sys_db/$1" ] || die "'$1' not found"
    local conflict_name="$1${2//\//>}"
    [ -e "$sys_ch/$conflict_name" ] || die "Alternative '$1 $2' doesn't exist"
    if [ -e "$LXPKG_ROOT$2" ]; then
        other_pkg=$(grep -l "^$2$" "$sys_db"/*/manifest | head -n 1)
        other_pkg=$(basename "$(dirname "$other_pkg")")
        [ -n "$other_pkg" ] || die "File '$2' exists but isn't owned by any package"
        log "Swapping '$2' from '$other_pkg' to '$1'"
        other_conflict_name="$other_pkg${2//\//>}"
        mv -f "$LXPKG_ROOT$2" "$sys_ch/$other_conflict_name"
        sed -i "s|^$2$|$cho_db/$other_conflict_name|" "$sys_db/$other_pkg/manifest"
    fi
    mv -f "$sys_ch/$conflict_name" "$LXPKG_ROOT$2"
    sed -i "s|^$cho_db/$conflict_name$|$2|" "$sys_db/$1/manifest"
}

# Install package
pkg_install() {
    local pkg="$1"
    pkg_find "$pkg" || die "Package '$pkg' not found"
    pkg_find_version "$pkg"
    pkg_check_system "$pkg" && return 0
    local install_root="${BOOTSTRAP_LXPKG:-${LXPKG_ROOT:-/}}"
    
    # Validate version and release
    local clean_ver=$(printf '%s' "$repo_ver" | sed 's/[^0-9a-zA-Z.-]//g')
    local clean_rel=$(printf '%s' "$repo_rel" | sed 's/[^0-9a-zA-Z.-]//g')
    [ -z "$clean_ver" ] && die "Invalid version ($repo_ver) for $pkg"
    clean_rel=${clean_rel:-0}
    
    log "Preparing to install $c_cyan$pkg$c_reset version $c_green$repo_ver-$repo_rel$c_reset to $c_purple$install_root$c_reset"
    
    # Check disk space
    [ -z "$install_root" ] && die "Install root is empty"
    local disk_space=$(df -k "$install_root" | tail -1 | awk '{print $4}' 2>/dev/null || echo 0)
    [ "$disk_space" -lt 1024 ] && die "Insufficient disk space in $install_root (< 1MB available)"
    
    # Check and verify checksums
    if [ "$LXPKG_SKIP_CHECKSUMS" != "1" ] && pkg_checksums "$pkg"; then
        pkg_verify "$pkg" || {
            warn "Checksum verification failed for $pkg"
            prompt "Continue with installation of $pkg?"
        }
    else
        log "Skipping checksum verification for $pkg"
    fi
    
    # Attempt to use cached package or build
    log "Checking for cached package $pkg@$repo_ver-$repo_rel"
    if ! pkg_cache "$pkg"; then
        log "No cache found, building $pkg"
        pkg_source "$pkg" || die "Failed to download or extract sources for $pkg"
        pkg_build "$pkg" || die "Build failed for $pkg"
    fi
    
    cd "$repo_dir" || die "Failed to change to repository directory $repo_dir"
    mkdir -p "$pkg_dir/$pkg/$pkg_db/$pkg" || die "Failed to create package directory $pkg_dir/$pkg/$pkg_db/$pkg"
    
    # Generate manifest if not exists
    [ -f "$pkg_dir/$pkg/$pkg_db/$pkg/manifest" ] || {
        log "$pkg: Generating manifest"
        (cd "$pkg_dir/$pkg" && find . -type f -o -type l | sed 's|^\./||' > "$pkg_dir/$pkg/$pkg_db/$pkg/manifest") || die "Failed to generate manifest for $pkg"
    }
    
    # Validate manifest
    local file_count=$(wc -l < "$pkg_dir/$pkg/$pkg_db/$pkg/manifest" 2>/dev/null || echo 0)
    [ "$file_count" -eq 0 ] && die "Manifest is empty for $pkg"
    
    # Fix dependencies
    pkg_fix_deps "$pkg"
    
    # Generate etcsums and strip binaries
    pkg_etcsums "$pkg"
    pkg_strip "$pkg"
    pkg_conflicts "$pkg"
    
    # Install files with progress bar
    log "Installing $c_cyan$pkg$c_reset version $c_green$repo_ver-$repo_rel$c_reset ($file_count files)"
    local i=0 dir_count=0 file_count_actual=0
    while read -r file; do
        i=$((i + 1))
        local percent=$((i * 100 / file_count))
        printf '\r%b%s %bInstalling %s: %3d%% [%s]%b' "$c_grey" "==>" "$c_grey" "$pkg" "$percent" "$(printf '%*s' "$((percent / 5))" | tr ' ' '#')" "$c_reset"
        
        case $file in
            */)
                dir_count=$((dir_count + 1))
                mkdir -p "$install_root/$file" 2>/dev/null || warn "Failed to create directory $install_root/$file"
                ;;
            *)
                case $file in
                    /etc/*[!/])
                        pkg_etc "$pkg" "$file" && continue
                        ;;
                    var/db/lxpkg/installed/*)
                        continue
                        ;;
                esac
                mkdir -p "$install_root${file%/*}" || warn "Failed to create directory $install_root${file%/*}"
                src_file="$pkg_dir/$pkg/$file"
                dest_file="$install_root/$file"
                if [ -f "$src_file" ] || [ -L "$src_file" ]; then
                    if cp -f "$src_file" "$dest_file" 2>/dev/null; then
                        file_count_actual=$((file_count_actual + 1))
                        [ "${LXPKG_VERBOSE:-0}" -eq 1 ] && log "Installed $src_file to $dest_file"
                    else
                        warn "Failed to install $src_file to $dest_file"
                    fi
                else
                    warn "Source file $src_file not found, skipping"
                fi
                ;;
        esac
    done < "$pkg_dir/$pkg/$pkg_db/$pkg/manifest"
    printf '\r%b%s %bInstalled %s: %3d%% [%-20s] (%d files, %d dirs)%b\n' "$c_grey" "==>" "$c_grey" "$pkg" 100 "$(printf '%*s' 20 | tr ' ' '#')" "$file_count_actual" "$dir_count" "$c_reset"
    
    # Record in package database
    log "Recording $pkg in package database at $sys_db/$pkg"
    mkdir -p "$sys_db/$pkg" || die "Failed to create database directory $sys_db/$pkg"
    printf '%s %s\n' "$clean_ver" "$clean_rel" > "$sys_db/$pkg/version" || die "Failed to write version file for $pkg"
    cp -f "$repo_dir/depends" "$sys_db/$pkg/depends" 2>/dev/null || :
    cp -f "$pkg_dir/$pkg/$pkg_db/$pkg/etcsums" "$sys_db/$pkg/etcsums" 2>/dev/null || :
    cp -f "$pkg_dir/$pkg/$pkg_db/$pkg/manifest" "$sys_db/$pkg/manifest" || die "Failed to copy manifest for $pkg"
    
    # Handle alternatives
    pkg_alternatives "$pkg" 2>/dev/null || warn "Failed to manage alternatives for $pkg"
    
    # Run post-install script if present
    if [ -f "$repo_dir/post-install" ]; then
        log "Running post-install script for $pkg"
        if [ "${LXPKG_VERBOSE:-0}" -eq 1 ]; then
            sh -e "$repo_dir/post-install" "$install_root/" 2>&1 | while read -r line; do log "Post-install: $line"; done || warn "Post-install script failed for $pkg"
        else
            sh -e "$repo_dir/post-install" "$install_root/" || warn "Post-install script failed for $pkg"
        fi
    fi
    
    log "Successfully installed $c_cyan$pkg$c_reset version $c_green$repo_ver-$repo_rel$c_reset"
}

# Create temporary directories
create_tmp_dirs() {
    log "Setting up temporary directories..."
    cache_dir=${LXPKG_CACHEDIR:-/var/cache/lxpkg}
    src_dir=/tmp/lxpkg-$LOGNAME/src
    bld_dir=/tmp/lxpkg-$LOGNAME/build
    pkg_dir=/tmp/lxpkg-$LOGNAME/pkg
    
    for dir in "$src_dir" "$bld_dir" "$pkg_dir"; do
        if [ -d "$dir" ]; then
            log "Cleaning existing directory $dir"
            rm -rf "$dir" || die "Failed to clean existing directory $dir"
        fi
        mkdir -p "$dir" || die "Failed to create directory $dir"
    done
    
    mkdir -p "$cache_dir" || die "Failed to create cache directory $cache_dir"
    sys_db=${LXPKG_ROOT:-/}var/db/lxpkg/installed
    sys_ch=${LXPKG_ROOT:-/}var/db/lxpkg/choices
    pkg_db=var/db/lxpkg/installed
    log "Temporary directories ready: $src_dir, $bld_dir, $pkg_dir"
}

# Set up trap
trap_on() {
    trap 'rm -rf "$src_dir" "$bld_dir" "$pkg_dir"; exit' INT TERM EXIT
}

# Parse arguments
args() {
    sys_db=${LXPKG_ROOT:-/}var/db/lxpkg/installed
    case $1 in
        a|alternatives) shift; pkg_alternatives "$@";;
        b|build) shift; for pkg; do pkg_build "$pkg"; done ;;
        c|checksum) shift; for pkg; do pkg_checksums "$pkg"; done ;;
        clean) shift; pkg_clean_cache ;;
        d|depends) shift; for pkg; do pkg_depends_list "$pkg"; done ;;
        i|install) shift; for pkg; do pkg_install "$pkg"; done ;;
        m|manifest) shift; for pkg; do pkg_manifest "$pkg"; done ;;
        o|owns) shift; for file; do pkg_owns "$file"; done ;;
        O|orphans) shift; pkg_orphans ;;
        r|remove) shift; for pkg; do pkg_remove "$pkg"; done ;;
        R|revdepends) shift; for pkg; do pkg_revdepends "$pkg"; done ;;
        rr|reporevdepends) shift; for pkg; do pkg_reporevdepends "$pkg"; done ;;
        s|search) shift; pkg_search "$@";;
        S|size) shift; for pkg; do pkg_size "$pkg"; done ;;
        l|list) shift; pkg_list ;;
        u|update) shift; pkg_update ;;
        U|upgrade) shift; pkg_upgrade ;;
        v|version) log "lxpkg version 1.2.7" ;;
        h|help)
            printf '%b%s%b\n' "$c_green" "lxpkg: Package manager for lxos" "$c_reset"
            printf '%b%s%b\n' "$c_grey" "Usage: lxpkg [command] [pkg...]" "$c_reset"
            printf '%b%s%b\n' "$c_green" "Commands:" "$c_reset"
            for cmd in \
                "a,alternatives:List or swap package alternatives" \
                "b,build:Build packages from source" \
                "c,checksum:Generate package checksums" \
                "clean:Clean package cache" \
                "d,depends:List package dependencies" \
                "i,install:Install packages" \
                "m,manifest:Show installed package files" \
                "o,owns:Show which package owns a file" \
                "O,orphans:List orphaned packages" \
                "r,remove:Remove packages" \
                "R,revdepends:List installed reverse dependencies" \
                "rr,reporevdepends:List repository reverse dependencies" \
                "s,search:Search for packages" \
                "S,size:Show package size" \
                "l,list:List installed packages" \
                "u,update:Update repositories" \
                "U,upgrade:Upgrade installed packages" \
                "v,version:Show lxpkg version" \
                "h,help:Show this help message"; do
                printf '  %b%-20s%b %s\n' "$c_cyan" "${cmd%%:*}" "$c_reset" "${cmd#*:}"
            done
            printf '%b%s%b\n' "$c_green" "Configuration file found in /etc/lxpkg.conf:" "$c_reset"
            for var in \
                "BOOTSTRAP_LXPKG:Install to a custom root (e.g., /mnt)" \
                "LXPKG_PATH:Repository paths (default: /usr/src/lxpkg/repo)" \
                "LXPKG_COMPRESS:Compression type (gz, xz, zst; default: xz)" \
                "LXPKG_SKIP_CHECKSUMS:Skip checksum verification (set to 1)" \
                "LXPKG_STRIP:Disable binary stripping (set to 0)" \
                "LXPKG_VERBOSE:Enable verbose logging (set to 1)"; do
                printf '  %b%-20s%b %s\n' "$c_cyan" "${var%%:*}" "$c_reset" "${var#*:}"
            done
            exit 0
            ;;
        *) printf '%b%s%b\n' "$c_grey" "lxpkg h for help" "$c_reset"; exit 1 ;;
    esac
}

# Main function
main() {
    create_default_conf
    [ -f "/etc/lxpkg.conf" ] && . /etc/lxpkg.conf
    : "${LXPKG_PATH:=/usr/src/lxpkg/repo}"
    : "${LXPKG_COMPRESS:=xz}"
    : "${LXPKG_VERBOSE:=0}"
    : "${LXPKG_ROOT:=/}"
    [ "$LXPKG_COLOR" = 0 ] || [ ! -t 2 ] || {
        c_reset='\033[m'
        c_grey='\033[3;90m'
        c_green='\033[1;32m'
        c_cyan='\033[1;36m'
        c_purple='\033[3;35m'
        c_yellow='\033[1;33m'
        c_red='\033[1;31m'
        c_blue='\033[1;34m'
    }
    ppwd=$PWD
    cmd_su=${LXPKG_SU:-"$(command -v lx || command -v sudo || command -v doas || command -v su)"} || cmd_su=su
    cmd_get=${LXPKG_GET:-"$(command -v aria2c || command -v axel || command -v curl || command -v wget)"} || die "No download utility found"
    
    # Only create temp directories for commands that need them
    case "$1" in
        b|build|c|checksum|i|install)
            create_tmp_dirs
            trap_on
            ;;
    esac
    
    [ "$(id -u)" -eq 0 ] || [ -n "$BOOTSTRAP_LXPKG" ] || [ -n "$LXPKG_SUDO" ] || exec $cmd_su "$0" "$@"
    args "$@"
}

main "$@"
